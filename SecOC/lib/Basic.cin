void CompareParameters(byte data[], dword length)
{
  word msgType;
  int rel;
  byte payload[1500];
  msgType = (dword)(data[2]<<8) + (dword)( data[3]);
  
  if(msgType == 0x8001) //Diagnostic message
  {
    memcpy_off(payload, 0, data, 8, length);
    if(memcmp(payload, expectdata, expectLen)==0)
      testSupplyTextEvent(Diagmsg);
    return;
  }
 
  if(msgType == 0x8002) //Diagnostic message positive acknowledgement
  {
    if(data[12] !=0)
      testStep("CompareParameters", "Diagnost ack message with ack code is 0x%x", data[12]);
    testSupplyTextEvent(Diagackmsg);
    return;
  }
  
  if(msgType== 0x8003) //Diagnostic message negative acknowledgement
  {
    memcpy_off(payload, 0, data, 8, length);
    if(memcmp(payload, expectdata, expectLen)==0)
      testSupplyTextEvent(Diagnackmsg);
    return;
  }
  
  if(msgType == 0x07) //Alive check request
  {
    testSupplyTextEvent(AliveCheck);
    return;
  }
  
  if(msgType == 0x00) //Generic DoIP header negative acknowledge
  {
    memcpy_off(payload, 0, data, 8, length);
    if(memcmp(payload, expectdata, expectLen)==0)
      testSupplyTextEvent(HeaderNack);
    return;
  }
  
  if(msgType == 0xF002) //F0002
  {
      testSupplyTextEvent(PayloadTypeF002);
    return;
  }
  if(msgType == 0xF005) //F0005
  {
      testSupplyTextEvent(PayloadTypeF005);
    return;
  }
  if(msgType == 0xF007) //F0007
  {
      testSupplyTextEvent(PayloadTypeF007);
    return;
  }
   if(msgType == 0x06) //Routing activation response
  {
    memcpy_off(payload, 0, data, 8, length);
    if(memcmp(payload, expectdata, expectLen)==0)
      testSupplyTextEvent(Routresp);
    return;
  }
  
  if(msgType == 0x04)  //Vehicle announcement message
  {
    testSupplyTextEvent(vehicileId1);
    memcpy_off(payload, 0, data, 8, length);
    if(memcmp(payload, expectdata, expectLen)==0)
      testSupplyTextEvent(vehicileId);
    return;
  }
  if(msgType == 0x4002) //DoIP entity status response
  {
    testSupplyTextEvent(vehicileId1);
    memcpy_off(payload, 0, data, 8, length);
    if(memcmp(payload, expectdata, expectLen)==0)
      testSupplyTextEvent(DoIPEntity);
    return;
  }
 
  if(msgType == 0x4004) //Diagnostic power mode information response
  {
    testSupplyTextEvent(PowerMode);
    return;
  }
}



void BeginTest(char logName[])
{ 
  char timestap[50];
     char s[200];
    char report[200];
  strncpy(s, "TestLogs\\", 100);
  strncat(s, logName, 100);
  strncat(s, "\\", 100);
  strncat(s, logName, 100);
  strncat(s,"-", 100);
    if(mbstrlen(timestap)==0)
  {
    char tem[100];
    stopLogging();
    testWaitForTimeout(1000);
    getLocalTimeString(tem);
    mbsubstr_cpy_off(timestap, 0, tem, 4, 15);
    timestap[3]='_';
    timestap[6]='_';
    timestap[9]='_';
    timestap[12]='_';
  }
  strncat(s,timestap, 200);
  strncpy(report, s, 200);
  strncat(s, ".asc", 200);
  write("%s", s);
  setLogFileName("Logging", s);
  startLogging("Logging");
  TestReportFileName(report);
  StopTest_Flag=0;
  Getparameters();
  ResetSocketID();
  // Add Tester Source Address IP into network
  ipAddAdapterAddress(1, ipGetAddressAsNumber(TesterIpStr), ipGetAddressAsNumber("255.255.0.0"));
}
void disconnectSocket( )
{
  int i;
    for(i = 0; i< max; i++)
  {
    if(TcpSocket[i] != 0)
    {
      TcpClose(TcpSocket[i]);
      break ;
    }
  }
}

export testfunction StopTest()
{
  StopTest_Flag=1;
  testWaitForTimeout(2000);
  ResetSocketID();
  stopLogging();
  setLogFileName("Logging", "MAIN_LOG");
  startLogging("Logging");
  stopLogging();
  
}
export testfunction Reset_P_Switch_ECU()
{
  // Reset Power
  testStepPass("P_Switch","Turn off -> turn on");

  @sysvar::KA3005P::P_Switch=0;
  testWaitForTimeout(1000);
  @sysvar::KA3005P::P_Switch = 1;
}

export testfunction Reset_P_Switch_ECU_Report_502()
{
  // Reset Power
  testStepPass("P_Switch","Turn off -> turn on");
  @sysvar::KA3005P::P_Switch = 0;
  testWaitForTimeout(1000);
  @sysvar::KA3005P::P_Switch = 1;
  testWaitForTextEvent("ECU_Wakeup_502", 10000);
}
export testfunction ResetSocketID()
{
  int i;
  long rel;
  char err_String[100];
  
  for(i = 0; i< max; i++)
  {
    tcpAbort(TcpSocket[i]);
    TcpSocket[i] = 0;
  }  
//  testWaitForTimeout(200);
}
export testfunction CloseSocketID()
{
 byte i;
  for(i = 0; i< max; i++)
  {
    if(TcpSocket[i] != 0)
    {
      if(tcpClose(TcpSocket[i]) == 0)
      {
        TcpSocket[i] = 0;
      }
    }
  }  
//  testWaitForTimeout(200);
}

