export testfunction Check_DTC_ETH_RAW(long Timeout, byte SrcAddr[], byte DesAddr[], byte DTCs[])
{
  byte expectdata[1500];
  long rel;
  byte i;
  char str[1500]; 
  char str_DTC[1500];
  byte UdsData[6]={0x0E,0x80,0x10,0x15,0x59,0x02};
  byte expecttdata2[1500];
  dword lendoip;
  L4Protocol = kTcp; 
  memcpy_off(expectdata, 0, SrcAddr, 0, 2);
  memcpy_off(expectdata, 2, DesAddr, 0, 2); 
  memcpy_off(expectdata, 4, UdsData, 0,  elCount(UdsData)); 
  expectLen = 4 + elCount(UdsData);
  ByteArray_To_String(expectdata, expectLen, str);
  memcpy_off(expecttdata2, 0, DTCs, 0,  elCount(DTCs)); 
  ByteArray_To_String(expecttdata2, elCount(DTCs), str_DTC);
  testStep("WaitForDiagnosticMessageResp", "Expect receive diagnostic message: %s", str);
  rel = testWaitForTextEvent(Diagmsg, Timeout);
  if (rel==1)
  {
    testStep("Check DTC"," Expect DTC: %s",str_DTC);
    for (i=0;i<255;i++)
    {
      if(datadoip[i]==DTCs[0] &&datadoip[i+1]==DTCs[1]&&datadoip[i+2]==DTCs[2] &&datadoip[i+3]==0x2F)
      {
        testStepPass("Check DTC", "Exist DTC: %s 2F",str_DTC);
        rel=0;
        break;
      }
    }
    if(rel==1)  testStepFail("Check DTC", "Don't Exist DTC: %s 2F",str_DTC);
  }
  else
   testStepFail("WaitForDiagnosticMessageResp", "Diagnostic no reply");
}
void Add_DTC_1904(byte DTCs[])
{
  Req_1904FF[2]=DTCs[0];
  Req_1904FF[3]=DTCs[1];
  Req_1904FF[4]=DTCs[2];
}
export testfunction Return_Snap_shot(long Timeout, byte DID[])
{
  long rel;
  long j,i;
  byte expecttdata2[1500];
  char str_snapshot[1500];
    char str_data_DID[100];
  char str_DID[10];
  rel=testWaitForTextEvent(Diagmsg, Timeout);
  ByteArray_To_String(DID, elcount(DID), str_DID);

  if(rel==1)
  {
    testStepPass("WaitForDiagnosticMessageResp", "Diagnostic Packet:%s ",str_DOIP_packet);
    rel=0;
     for (i=0;i<255;i++)
    {
      if(datadoip[i]==DID[0] && datadoip[i+1]==DID[1])
      {
        rel=1;
        StartDID=i;     
      }
    }
      if(rel==1)
    {
      
        for (i=StartDID;i<StartDID+8;i++)
        {    
          Snapshot[i-StartDID]=datadoip[i-2+4] ;      
        }
        ByteArray_To_String(Snapshot, elcount(Snapshot), str_data_DID);
       testStepPass("DIDSnapshot", "Found %s %s",str_DID,str_data_DID);
    }
    else
    {
      testStepFail("DIDSnapshot", "Not Found %s",str_DID);
    }
  }
  else
  {
    testStepFail("WaitForDiagnosticMessageResp", "Diagnostic no reply");
  }
  
  
}
int getBit(int number, int position) {
  byte bitValue ;
  dword shiftedNumber;
    // Shifting the bit at the desired position to the rightmost bit
 shiftedNumber = number >> position; // Shifting the bit at the desired position to the rightmost bit
  bitValue= shiftedNumber & 0x01;
////
    return bitValue;
}
