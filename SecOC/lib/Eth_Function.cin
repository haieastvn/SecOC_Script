/// <DoIPSend>
//Send packet test fuction
export testfunction  SendRoutingActivationReq(byte SrcLogicAddr[], byte ActivationType, dword SocketId)
{
  long rel;
  char err_String[100]; 
  char str[1500];
  TxPktData[0] = 0x02;
  TxPktData[1] = 0xFD;
  TxPktData[2] = 0x00;
  TxPktData[3] = 0x05;
  TxPktData[4] = 0x00;
  TxPktData[5] = 0x00;
  TxPktData[6] = 0x00;
  TxPktData[7] = 0x07;
  TxPktData[8] = SrcLogicAddr[0];
  TxPktData[9] = SrcLogicAddr[1];
  TxPktData[10] = ActivationType;
  TxPktData[11] = TxPktData[12] = TxPktData[13] = TxPktData[14] = 0x00;
  TxPktData[15] = TxPktData[16] = TxPktData[17] = TxPktData[18] = 0xFF;
  
  rel = tcpSend(SocketId, TxPktData, 15);
  if (rel == 0)
  { 
    ByteArray_To_String(TxPktData, 15, str);
    TestSteppass ("sendRoutingActivationReq"," Tester send routing activation request: %s", str);
  }
 else if ((rel == -1) && (IpGetLastSocketError(SocketId)== 997))
  {
    ByteArray_To_String(TxPktData, 15, str);
    TestSteppass ("sendRoutingActivationReq"," Tester send routing activation request: %s", str);
  }
  else
  {
    IpGetLastSocketErrorAsString( SocketId, err_String, elcount(err_String));
    TestStepFail("sendRoutingActivationReq", " Tester sended Routing Activation Request failed with result %d (%s)", IpGetLastSocketError(SocketId), err_String ); 
  }
}
