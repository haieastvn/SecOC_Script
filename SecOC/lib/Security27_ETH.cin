on timer tmr_01_02
{
   Send_Diagnostic_Msg(0xE80,0x1fff,DiagMsgSecLv1_2,5+4);
}

on timer tmr_05_06
{
   	Send_Diagnostic_Msg(0xE80,0x1015,DiagMsgSecLv5_6,5+4);

}

on timer tmr_19_1A
{
   	Send_Diagnostic_Msg(0xE80,0x1015,DiagMsgSecLv19_1A,5+4);

}