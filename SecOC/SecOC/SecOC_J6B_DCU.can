/*@!Encoding:1252*/
includes
{
#include "SecOC_Func_Static.cin"
#include "SecOC_Parameter.cin"
}

variables
{
  diagRequest SAIC_J6B_DCU.* DiagReq_SAIC;
  diagRequest SAIC_J6B_DCU.* DiagResp_SAIC;
	message FDR_BKPCANFD_NM nm1; // CAN1,CAN2
	message IBS_SFCANFD_NM nm2;	 // CAN3,CAN4
	msTimer NMMsg_normal;
	msTimer timer50ms,timer10ms;
	message *SynMessage_global;
	dword trip_Cnt_global;
	dword reset_Cnt_global;
	byte SynMessage_global_Cnt = 0;
  byte timer10ms_cnt=0;
  
  //Comkey Request/ tripcntReset request
	Pdu ICBVC_SecOCComKeyReq_PDU01 ICBVC_SecOCComKeyReq_PDU01_pdu;
	message ICBVC_SecOC_ComKeyReq ICBVC_SecOC_ComKeyReq_msg2;
  
//	Pdu FDR_SecOCComKeyResp_PDU01 FDR_SecOCComKeyResp_PDU01_pdu;
//  message FDR_SecOC_ComKeyResp FDR_SecOC_ComKeyResp_msg;
  
  //tripReset Response
  pdu ICBAD_SecOCComKeyResp_PDU01 ICBAD_SecOCComKeyResp_PDU01_pdu;
  message ICBAD_SecOC_ComKeyResp ICBAD_SecOC_ComKeyResp_msg;
  
  //Comkey response
  pdu IPD_Sporadic_PDU35 IPD_Sporadic_PDU035_pdu;
  message IPD_BKPCANFD_Event_FrS35 IPD_BKPCANFD_Event_FrS35_msg;
  
	pdu ICBAD_SecOCLog_PDU01 ICBAD_SecOCLog_PDU01_pdu;
	message ICBAD_SecOC_Log ICBAD_SecOC_Log_msg;
}
on timer NMMsg_normal
{
	nm1.byte(0) = 0x00;
	nm1.byte(1) = 0x00;
	nm1.byte(2) = 0x00;
	nm1.byte(3) = 0x00;
	nm1.byte(4) = 0x00;
	nm1.byte(5) = 0x00;
	nm1.byte(6) = 0x00;
	nm1.byte(7) = 0x00;

	nm2.byte(0) = 0x00;
	nm2.byte(1) = 0x00;
	nm2.byte(2) = 0x00;
	nm2.byte(3) = 0x00;
	nm2.byte(4) = 0x00;
	nm2.byte(5) = 0x00;
	nm2.byte(6) = 0x00;
	nm2.byte(7) = 0x00;
	output(nm1);
	output(nm2);
	setTimer(NMMsg_normal, 10);
}
on timer timer50ms
{

	Send_SecOC_Sync_Msg(SynMessage_global, trip_Cnt_global, reset_Cnt_global);
	SynMessage_global_Cnt = SynMessage_global_Cnt + 1;
  
	if (SynMessage_global_Cnt < 3)
	{
		setTimer(timer50ms, 50);
	}
}
on timer timer10ms
{

	triggerPDU(ICBVC_SecOCComKeyReq_PDU01_pdu);
	timer10ms_cnt = timer10ms_cnt + 1;
	if (timer10ms_cnt < 3)
	{
		setTimer(timer10ms, 50);
	}
}
