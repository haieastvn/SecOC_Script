/// <DoIPSend>
export testfunction  SendUdpDoIPMessage(byte ProVer, byte InverseVer, word msgtype, dword Len, byte payloaddata[])
{
  int i;
  ethernetPacket IPLMMsg;
  IPLMMsg.Clear();
  IPLMMsg.source = EthGetMacAddressAsNumber( "02:00:00:00:10:01" );
  
  IPLMMsg.destination = EthGetMacAddressAsNumber( "2:00:00:00:14:60" );
  //IPLMMsg.destination = EthGetMacAddressAsNumber( "02:00:00:00:14:01" );

  IPLMMsg.ipv4.init();  

  IPLMMsg.ipv4.source.ParseAddress("198.18.32.1");
  
  IPLMMsg.ipv4.destination.ParseAddress("198.18.32.96");
  //IPLMMsg.ipv4.destination.ParseAddress("198.18.36.1");
  
  IPLMMsg.udp.Init();   
  
  IPLMMsg.udp.source = 13400;
  
  IPLMMsg.udp.destination = 13400;
  
//  IPLMMsg.SetVlanId(6);
//  IPLMMsg.SetVlanPriority(7);
  
  IPLMMsg.byte(28) = ProVer;//service id
  IPLMMsg.byte(29) = InverseVer;//service id
  
  IPLMMsg.byte(30) = (byte)(msgtype>>8);
  IPLMMsg.byte(31) = (byte)(msgtype);
  
  IPLMMsg.byte(32) = (byte)(Len >> 24 );
  IPLMMsg.byte(33) = (byte)(Len >> 16 );
  IPLMMsg.byte(34) = (byte)(Len >> 8 );
  IPLMMsg.byte(35) = (byte)(Len );
  for( i=0;i<(elCount(payloaddata));i++)
  {
    IPLMMsg.byte(36+i)=payloaddata[i];
  }  
  IPLMMsg.Length = 36+(elCount(payloaddata));
  IPLMMsg.CompletePacket();
  
  output(IPLMMsg);
//  rel = udpSendTo(socket, ipGetAddressAsNumber(DesIp), DesPort, TxPktData, elCount(payloaddata) +8 );
//  if (rel == 0)
//  { 
//    ByteArray_To_String(TxPktData, 19, str);
//    TestSteppass ("SendUdpDoIPMessage"," Tester send routing request by UDP: %s", str);
//  }
// else if ((rel == -1) && (IpGetLastSocketError(socket)== 997))
//  {
//    ByteArray_To_String(TxPktData, 19, str);
//    TestSteppass ("SendUdpDoIPMessage"," Tester send routing request by UDP: %s", str);
//  }
//  else
//  {
//    IpGetLastSocketErrorAsString( socket, err_String, elcount(err_String));
//    TestStepFail("VehicleIdentifcationRequestMessage", " DUT sended vehicle identifcation request failed with result %d (%s)", IpGetLastSocketError(socket), err_String ); 
//  } 
}


