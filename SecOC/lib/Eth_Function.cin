/// <DoIPSend>
export testfunction  SendDianosticMessae(byte SrcLogicAddr[], byte TarLogicAddr[], byte UdsData[], dword SocketId)
{
  long rel;
  char err_String[100], str[1500];
  dword len;
  len = elCount(UdsData) + 4;
  TxPktData[0] = 0x02;
  TxPktData[1] = 0xFD;
  TxPktData[2] = 0x80;
  TxPktData[3] = 0x01;
  TxPktData[4] = (byte)(len >>24);
  TxPktData[5] = (byte)(len >>16);
  TxPktData[6] = (byte)(len >>8);
  TxPktData[7] = (byte)(len >>0);
  TxPktData[8] = SrcLogicAddr[0];
  TxPktData[9] = SrcLogicAddr[1]; 
  TxPktData[10] = TarLogicAddr[0];
  TxPktData[11] = TarLogicAddr[1];
  memcpy_off(TxPktData, 12, UdsData, 0, elCount(UdsData));  
  rel = tcpSend(SocketId, TxPktData, elCount(UdsData)+ 12 );
  if (rel == 0)
  { 
    ByteArray_To_String(TxPktData, elCount(UdsData)+ 12, str);
