      }else{
        u32_s_PositionC = u32_s_PositionC |((u32_s_PositionC6<<5));
      }
      if((u32_s_PositionB>>3)&0x1){
        u32_s_PositionC = u32_s_PositionC &((u32_s_PositionC4<<3)|0xFFFFF7);
      }else{
        u32_s_PositionC = u32_s_PositionC |((u32_s_PositionC4<<3));
      }
      u32_s_PositionA = u32_s_PositionC;
      
    }
  }
 
    iopKeyArray[0] = (byte)((u32_s_PositionC >> 4)&0xff);
	iopKeyArray[1] = ((byte)(u32_s_PositionC >> 8) & 0xF0) | (byte)(u32_s_PositionC >> 20);
	iopKeyArray[2] = ((((byte)u32_s_PositionC) << 4) | ((byte)(u32_s_PositionC >> 16) & 0x0F));
	
  
  DiagMsgSecLv5_6[2] = iopKeyArray[0];
  DiagMsgSecLv5_6[3] = iopKeyArray[1];
  DiagMsgSecLv5_6[4] = iopKeyArray[2];
  
//  @Test::Key_Array_3_Bytes[0] = iopKeyArray[0];
//  @Test::Key_Array_3_Bytes[1] = iopKeyArray[1];
//  @Test::Key_Array_3_Bytes[2] = iopKeyArray[2];

  
  write ("iopKeyArray %x %x %x", iopKeyArray[0], iopKeyArray[1], iopKeyArray[2]);
  write ("DiagMsgSecLv1_2 %x %x %x", DiagMsgSecLv5_6[2], DiagMsgSecLv5_6[3], DiagMsgSecLv5_6[4]);
  testStep("Security","Send 27 06 ");
////  if(@Test::Unlock_0506 == 1)
////  {
