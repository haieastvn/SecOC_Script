testcase TC_SecOC_12()
{
	long result;
	byte Data_Msg[64];
	byte Data_Msg_Len;
	byte i;
	BeginTest("TC_SecOC_12");

	Reset_P_Switch_ECU();

	setTimer(NMMsg_normal, 10);
	result = testWaitForTextEvent(ECU_Wakeup, 5000);
	if (result == 1)
	{
		testStepPass("Precondition", "ECU wakeup");
	}
	else
		testStepFail("Precondition", "ECU didn't wakeup");

	ComKey_EnableReq(1);
	//  Verify_ComKey_EnableResp(1);
	//  TripCnt_ResetReq(1);
	//  Verify_TripCnt_ResetResp(1);
  testWaitForTimeout(200);
	Send_SecOC_Sync_Msg_J6B(SecOC_Syn_msg, 1, 1);

	Waitfor_Tx_Msg(IPD_BKPCANFD_50ms_FrP49_MsgID_0x2DD, 300);
	Verify_SecOC_Tx_Msg(IPD_BKPCANFD_50ms_FrP49_MsgID_0x2DD, 1, 1, 1);
	Reset_P_Switch_ECU();
	setTimer(NMMsg_normal, 10);
	result = testWaitForTextEvent(ECU_Wakeup, 5000);
	if (result == 1)
	{
		testStepPass("Precondition", "ECU wakeup");
	}
	else
		testStepFail("Precondition", "ECU didn't wakeup");
	//  ComKey_EnableReq(1);

	Waitfor_Tx_Msg(IPD_BKPCANFD_50ms_FrP49_MsgID_0x2DD, 300);
	Verify_SecOC_Tx_Msg(IPD_BKPCANFD_50ms_FrP49_MsgID_0x2DD, 1, 0, 1);

	StopTest();
}
testcase TC_SecOC_13()
{
	long result;
	byte Data_Msg[64];
	byte Data_Msg_Len;
	byte i;
	BeginTest("TC_SecOC_13");

	Reset_P_Switch_ECU();

	setTimer(NMMsg_normal, 10);
	result = testWaitForTextEvent(ECU_Wakeup, 5000);
	if (result == 1)
	{
		testStepPass("Precondition", "ECU wakeup");
	}
	else
		testStepFail("Precondition", "ECU didn't wakeup");

	ComKey_EnableReq(1);
	Verify_ComKey_EnableResp(1);
	TripCnt_ResetReq(1);
	Verify_TripCnt_ResetResp(1);
  testWaitForTimeout(200);
	Send_SecOC_Sync_Msg_J6B(SecOC_Syn_msg, 1, 1);
  Verify_LogSecOC(SecOC_Syn_msg.id, 1, 1, 1);
  testWaitForTimeout(200);
	// Set signal latter
	Data_Msg_Len = RZCU_RZCUCANFD_10ms_FrP23_msg.Datalength - (MAC_Truncated_bitLen + Fv_truncated_bitLen) / 8;
	for (i = 0; i < Data_Msg_Len; i++)
	{
		Data_Msg[i] = i;
	}
	Send_SecOC_Rx_MsgWrongMAC(RZCU_RZCUCANFD_10ms_FrP23_msg, Data_Msg, Data_Msg_Len, 1, 1, 1);

  Verify_LogSecOC(RZCU_RZCUCANFD_10ms_FrP23_msg.id, 1, 1, 1);
	StopTest();
}

//--------------------------------------------------
// Function: Send_DiagnosticSessionControl_Extended
// Purpose : Send UDS Service 0x10 0x03 using diagRequest object
//--------------------------------------------------
void Send_DiagnosticSessionControl_Extended()
{
    long result;

    // Set request data: SID 0x10, Sub-function 0x03
    diagResize(DiagReq_SAIC, 2);
    diagSetPrimitiveByte(DiagReq_SAIC, 0, 0x10);
    diagSetPrimitiveByte(DiagReq_SAIC, 1, 0x03);

    // Send request and wait for response
    result = diagSendRequest(DiagReq_SAIC);

    if(result == 0)
    {
        write("UDS Request Sent: 10 03 (Extended Session)");
    }
    else
    {
        write("Failed to send UDS Request 10 03, Error Code: %d", result);
    }
}
//--------------------------------------------------
// Function: Send_SecurityAccess_RequestSeed
// Purpose : Send UDS Service 0x27 0x01 (Request Seed)
//--------------------------------------------------
void Send_SecurityAccess_RequestSeed()
{
    long result;

    // Resize request to 2 bytes
    diagResize(DiagReq_SAIC, 2);

    // Set SID and Sub-function
    diagSetPrimitiveByte(DiagReq_SAIC, 0, 0x27);
    diagSetPrimitiveByte(DiagReq_SAIC, 1, 0x01);

    // Send request
    result = diagSendRequest(DiagReq_SAIC);

    if(result == 0)
    {
        write("UDS Request Sent: 27 01 (Security Access - Request Seed)");
    }
    else
    {
        write("Failed to send 27 01, Error Code: %d", result);
    }
}


//--------------------------------------------------
// Function: Send_SecurityAccess_SendKey
// Purpose : Send UDS Service 0x27 0x02 (Send Key)
// Input   : keyByte0 ~ keyByte3 = Security Key bytes
//--------------------------------------------------
void Send_SecurityAccess_SendKey(byte keyByte0, byte keyByte1, byte keyByte2, byte keyByte3)
{
    long result;

    // Total length: SID + Sub + 4-byte Key
    diagResize(DiagReq_SAIC, 6);

    // Set SID and Sub-function
    diagSetPrimitiveByte(DiagReq_SAIC, 0, 0x27);
    diagSetPrimitiveByte(DiagReq_SAIC, 1, 0x02);

    // Set Security Key
    diagSetPrimitiveByte(DiagReq_SAIC, 2, keyByte0);
    diagSetPrimitiveByte(DiagReq_SAIC, 3, keyByte1);
    diagSetPrimitiveByte(DiagReq_SAIC, 4, keyByte2);
    diagSetPrimitiveByte(DiagReq_SAIC, 5, keyByte3);

    // Send request
    result = diagSendRequest(DiagReq_SAIC);

    if(result == 0)
    {
        write("UDS Request Sent: 27 02 (Security Access - Send Key)");
    }
    else
    {
        write("Failed to send 27 02, Error Code: %d", result);
    }
}

//--------------------------------------------------
// Function: Send_WriteDataByIdentifier_F130
// Purpose : Send UDS Service 0x2E DID F130 with 32-byte VSN data
//--------------------------------------------------
void Send_WriteDataByIdentifier_F130()
{
    long result;
    byte vsnData[32] = {
        0x01, 0x02, 0x03, 0x04,
        0x05, 0x06, 0x07, 0x08,
        0x09, 0x0A, 0x0B, 0x0C,
        0x0D, 0x0E, 0x0F, 0x10,
        0x11, 0x12, 0x13, 0x14,
        0x15, 0x16, 0x17, 0x18,
        0x19, 0x1A, 0x1B, 0x1C,
        0x1D, 0x1E, 0x1F, 0x20
    };

    int i;

    // Total length:
    // SID (1) + DID (2) + Data (32) = 35 bytes
    diagResize(DiagReq_SAIC, 35);

    // Service ID
    diagSetPrimitiveByte(DiagReq_SAIC, 0, 0x2E);

    // DID F130
    diagSetPrimitiveByte(DiagReq_SAIC, 1, 0xF1);
    diagSetPrimitiveByte(DiagReq_SAIC, 2, 0x30);

    // Write VSN data
    for(i = 0; i < 32; i++)
    {
        diagSetPrimitiveByte(DiagReq_SAIC, i + 3, vsnData[i]);
    }

    // Send request
    result = diagSendRequest(DiagReq_SAIC);

    if(result == 0)
    {
        write("UDS Request Sent: 2E F1 30 + 32-byte VSN");
    }
    else
    {
        write("Failed to send 2E F1 30, Error Code: %d", result);
    }
}

//--------------------------------------------------
//--------------------------------------------------
void Set_PreCondition_SecOC()
{
    // Step 1: Extended Diagnostic Session
    Send_DiagnosticSessionControl_Extended();
    testWaitForTimeout(100);

    // Step 2: Request Security Seed
    Send_SecurityAccess_RequestSeed();
    testWaitForTimeout(100);

    // Step 3: Send Security Key
    // Replace with actual calculated key if needed
    Send_SecurityAccess_SendKey(0x00, 0x00, 0x00, 0x00);
    testWaitForTimeout(100);

    // Step 4: Write VSN DID F130
    Send_WriteDataByIdentifier_F130();
    testWaitForTimeout(100);

    write("Precondition flow completed.");
}
