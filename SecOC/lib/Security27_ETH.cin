  for(j= 8;j>0;j--){
    
    for(i =0;i<8;i++){
      
      
      u32_s_PositionB = ((u32_s_PositionA &0x01)^ ((u8_s_ChangeBitList_FixByte_Seed_05_06[j-1]>>i)&0x01));
      u32_s_PositionB = (u32_s_PositionB<<23)&0x800000;
