byte CRC_crc8Table(byte data[], dword len, byte table[],byte startVal, byte xorVal)
{
  dword index = 0;
  byte  crc = 0;
  
  crc = startVal ^ xorVal;
  
  for (index = 0; index < len; index++)
  {
      crc = table[crc ^ data[index]];
  }

  crc ^= xorVal;
    
  return crc;
}


void memcpy_offset(byte dest[], byte src[], byte offset, dword len)
{
  int i = 0;
  
  for(i=offset; i<(len+offset); i++)
  {
     dest[i-offset] = src[i];
  }
}

int FindIndex(dword pduID)
{
  int i;
  for(i=0;i<RxPDUCount;i++)
  {
    if(RxPDU.pduID[i] == pduID)
    {return i;}
  }
  return -1;
}

void PreProcess_CRC_Offset(byte data[], dword aDlc, byte DID[], byte count, byte crc_offset)
{
  byte data_temp[64];
  byte crc = 0;
  //calculate E2E DataID CRC
  crc = CRC_crc8Table(DID, 2, Crc_Table8H1D, 0xFF, 0xFF);
  
  //update rolling counter
  data[crc_offset+1] = (data[crc_offset+1] & 0xF0) | count; // first is zero
  
  //calculate E2E Data ID CRC
  
  memcpy_offset(data_temp, data, crc_offset+1, aDlc-1);
  crc = CRC_crc8Table(data_temp, aDlc-1, Crc_Table8H1D, crc, 0xFF);
  
  data[crc_offset] = crc ^ 0xFF;
}
void PreProcess_calculateCount(byte deltacounter,byte index)
{
      RxPDU.E2E_Counter[index] = RxPDU.E2E_Counter[index] + deltacounter; 
      RxPDU.E2E_Counter[index] %= 0x0F;
//  write("%x",count[index]);
}


/* ==========================================
 *  CMAC over SM4 (CAPL 兼容版)
 *  关键点：
 *    - 不再使用 key/in/out 作为标识符
 *    - 形参数组使用不定长 []
 *    - 局部变量全部在函数顶部声明
 * ========================================== */

/* -------- 基础工具 -------- */

dword ROTL32(dword x, int n) {
  return ((x << n) | (x >> (32 - n)));
}

dword bytesToDwordBE(byte b[], int off) {
  dword v;
  v = 0;
  v |= ((dword)b[off]   & 0xFF) << 24;
  v |= ((dword)b[off+1] & 0xFF) << 16;
  v |= ((dword)b[off+2] & 0xFF) << 8;
  v |= ((dword)b[off+3] & 0xFF);
  return v;
}

void dwordToBytesBE(dword v, byte outBuf[], int off) {
  outBuf[off]   = (byte)((v >> 24) & 0xFF);
  outBuf[off+1] = (byte)((v >> 16) & 0xFF);
  outBuf[off+2] = (byte)((v >> 8)  & 0xFF);
  outBuf[off+3] = (byte)(v & 0xFF);
}

void xor16(byte a[], byte b[], byte outBuf[]) {
  int i;
  for (i = 0; i < 16; i++) {
    outBuf[i] = (byte)(a[i] ^ b[i]);
  }
}

/* 128-bit 左移 1 位 */
void leftShiftOneBit128(byte inBuf[], byte outBuf[]) {
  int i;
  byte carry;
  byte newCarry;
  carry = 0;
  for (i = 15; i >= 0; i--) {
    newCarry = ((inBuf[i] & 0x80) != 0) ? 1 : 0;
    outBuf[i] = (byte)((inBuf[i] << 1) & 0xFE);
    outBuf[i] = (byte)(outBuf[i] | carry);
    carry = newCarry;
  }
}


/* -------- SM4 变换 -------- */

dword sm4_tauSub(dword x) {
  byte b0;
  byte b1;
  byte b2;
  byte b3;
  dword r;

  b0 = (byte)((x >> 24) & 0xFF);
  b1 = (byte)((x >> 16) & 0xFF);
  b2 = (byte)((x >> 8)  & 0xFF);
  b3 = (byte)(x & 0xFF);

  b0 = SM4_SBOX[b0 & 0xFF];
  b1 = SM4_SBOX[b1 & 0xFF];
  b2 = SM4_SBOX[b2 & 0xFF];
  b3 = SM4_SBOX[b3 & 0xFF];

  r = ((dword)b0 << 24) | ((dword)b1 << 16) | ((dword)b2 << 8) | (dword)b3;
  return r;
}

/* L(B) = B ^ ROTL(B,2) ^ ROTL(B,10) ^ ROTL(B,18) ^ ROTL(B,24) */
dword sm4_L_enc(dword b) {
  return b ^ ROTL32(b, 2) ^ ROTL32(b, 10) ^ ROTL32(b, 18) ^ ROTL32(b, 24);
}

/* L'(B) = B ^ ROTL(B,13) ^ ROTL(B,23) */
dword sm4_L_key(dword b) {
  return b ^ ROTL32(b, 13) ^ ROTL32(b, 23);
}

dword sm4_T_enc(dword x) {
  return sm4_L_enc(sm4_tauSub(x));
}

dword sm4_T_key(dword x) {
  return sm4_L_key(sm4_tauSub(x));
}

/* -------- SM4 密钥扩展 & 单块加密 -------- */
/* 注意：这里的 k 是 16 字节的密钥 */
void sm4_setRk(byte k[], dword rk[]) {
  dword MK0, MK1, MK2, MK3;
  dword K0, K1, K2, K3;
  dword Ktmp0, Ktmp1, Ktmp2, Ktmp3;
  int i;
  dword t, Ki;

  MK0 = bytesToDwordBE(k, 0);
  MK1 = bytesToDwordBE(k, 4);
  MK2 = bytesToDwordBE(k, 8);
  MK3 = bytesToDwordBE(k, 12);

  K0 = MK0 ^ SM4_FK[0];
  K1 = MK1 ^ SM4_FK[1];
  K2 = MK2 ^ SM4_FK[2];
  K3 = MK3 ^ SM4_FK[3];

  Ktmp0 = K0; Ktmp1 = K1; Ktmp2 = K2; Ktmp3 = K3;

  for (i = 0; i < 32; i++) {
    t = Ktmp1 ^ Ktmp2 ^ Ktmp3 ^ SM4_CK[i];
    Ki = Ktmp0 ^ sm4_T_key(t);
    rk[i] = Ki;
    Ktmp0 = Ktmp1;
    Ktmp1 = Ktmp2;
    Ktmp2 = Ktmp3;
    Ktmp3 = Ki;
  }
}

void sm4_encryptBlock(byte inBlock[], byte outBlock[], dword rk[]) {
  dword X0, X1, X2, X3;
  dword x0, x1, x2, x3, t, x4;
  int i;

  X0 = bytesToDwordBE(inBlock, 0);
  X1 = bytesToDwordBE(inBlock, 4);
  X2 = bytesToDwordBE(inBlock, 8);
  X3 = bytesToDwordBE(inBlock, 12);

  x0 = X0; x1 = X1; x2 = X2; x3 = X3;

  for (i = 0; i < 32; i++) {
    t = x1 ^ x2 ^ x3 ^ rk[i];
    x4 = x0 ^ sm4_T_enc(t);
    x0 = x1;
    x1 = x2;
    x2 = x3;
    x3 = x4;
  }

  /* 输出为 (X35, X34, X33, X32) */
  dwordToBytesBE(x3, outBlock, 0);
  dwordToBytesBE(x2, outBlock, 4);
  dwordToBytesBE(x1, outBlock, 8);
  dwordToBytesBE(x0, outBlock, 12);
}

/* -------- CMAC(SM4) -------- */

/* 生成子密钥 K1, K2 (Rb=0x87) */
void cmac_sm4_generateSubkeys(byte k[], byte K1[], byte K2[]) {
  dword rk[32];
  byte Z[16];
  byte L[16];
  byte K1tmp[16];
  byte K2tmp[16];
  int i;

  for (i = 0; i < 16; i++) {
    Z[i] = 0x00;
  }

  sm4_setRk(k, rk);
  sm4_encryptBlock(Z, L, rk);

  leftShiftOneBit128(L, K1tmp);
  if ((L[0] & 0x80) != 0) {
    K1tmp[15] = (byte)(K1tmp[15] ^ 0x87);
  }
  for (i = 0; i < 16; i++) {
    K1[i] = K1tmp[i];
  }

  leftShiftOneBit128(K1, K2tmp);
  if ((K1[0] & 0x80) != 0) {
    K2tmp[15] = (byte)(K2tmp[15] ^ 0x87);
  }
  for (i = 0; i < 16; i++) {
    K2[i] = K2tmp[i];
  }
}

/* 计算 CMAC-SM4 */
void cmac_sm4(byte k[], byte msg[], int msgLen, byte mac[]) {
  dword rk[32];
  byte K1[16], K2[16];
  byte X[16];
  byte block[16];
  byte xored[16];
  byte last[16];
  byte xoredLast[16];
  int i, j;
  int n;
  int lastComplete;
  int rem;
  int idx;

  // ========================================================
  // FIX CHí M?NG: Kh?i t?o toàn b? m?ng local v? 0 
  // ?? ch?ng hi?n t??ng CAPL l?u tr?ng thái bi?n c?a l?n g?i tr??c
  // ========================================================
  for(i = 0; i < 32; i++) rk[i] = 0;
  for(i = 0; i < 16; i++) {
    K1[i] = 0; K2[i] = 0; X[i] = 0; 
    block[i] = 0; xored[i] = 0; last[i] = 0; xoredLast[i] = 0;
  }

  // B?t ??u tính toán thu?t toán
  sm4_setRk(k, rk);
  cmac_sm4_generateSubkeys(k, K1, K2);

  n = (msgLen + 15) / 16;
  lastComplete = (msgLen > 0) && ((msgLen % 16) == 0);
  if (n == 0) {
    n = 1;
    lastComplete = 0;
  }

  /* Tính cho (n-1) block ??u tiên */
  for (i = 0; i < n - 1; i++) {
    for (j = 0; j < 16; j++) {
      idx = i * 16 + j;
      if (idx < msgLen) {
        block[j] = msg[idx];
      } else {
        block[j] = 0x00;
      }
    }
    xor16(X, block, xored);
    sm4_encryptBlock(xored, X, rk);
  }

  /* X? ly block cu?i cùng */
  if (lastComplete) {
    for (j = 0; j < 16; j++) {
      last[j] = msg[(n - 1) * 16 + j];
    }
    for (j = 0; j < 16; j++) {
      last[j] = (byte)(last[j] ^ K1[j]);
    }
  } else {
    rem = msgLen - ((n - 1) * 16);
    // ?o?n gán last[j] = 0x00 ?? ???c cover b?i hàm clear ? trên cùng
    for (j = 0; j < rem; j++) {
      last[j] = msg[(n - 1) * 16 + j];
    }
    last[rem] = (byte)0x80; /* Padding bit */
    for (j = 0; j < 16; j++) {
      last[j] = (byte)(last[j] ^ K2[j]);
    }
  }

  /* T = E_k(X ^ last) */
  xor16(X, last, xoredLast);
  sm4_encryptBlock(xoredLast, mac, rk);
}

void Preprocess_SecOC(dword pduID, int index,dword aPayloadLength, byte data[])
{
//  byte keytest[16] = {0x01,0x02,0x03,0x04,0x05,0x06,0x07,0x08,0x09,0x0A,0x0B,0x0C,0x0D,0x0E,0x0F,0x10};
//  dword key_length = 16;
  byte MAC_in[64]={0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
                    0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
                    0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
                    0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
                    0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
                    0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
                    0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
                    0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  dword MAC_in_length;
  byte MAC_out[16];
  dword MAC_outLength = 16;
  dword Trip_Value;
  dword Reset_Value;
  qword freshnesstemp;
  dword freshnesslength;
  byte freshnessID[2] = {0x00,0x00};
  byte freshnessVal[8]= {0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte resetflag;
  int i,p;
  
  p=0;
  freshnessID[0] = (pduID>>8) & 0xFF;
  freshnessID[1] = (pduID) & 0xFF;
  
  if((RxPDU.prevTripCnt[index]==@sysvar::Security::TripCounter)&&(RxPDU.prevResetCnt[index]==@sysvar::Security::ResetCounter))
  {
    Trip_Value = RxPDU.prevTripCnt[index];
    Reset_Value = RxPDU.prevResetCnt[index];
    if(RxPDU.msgCnt[index]<=((2<<22)-1)){RxPDU.msgCnt[index]++;}
    else{RxPDU.msgCnt[index]=(2<<22)-1;}   
  }
  else
  {
    Trip_Value = @sysvar::Security::TripCounter;
    Reset_Value = @sysvar::Security::ResetCounter;
    RxPDU.msgCnt[index]=1; 
    RxPDU.prevTripCnt[index]=@sysvar::Security::TripCounter;
    RxPDU.prevResetCnt[index]=@sysvar::Security::ResetCounter;
  }

  resetflag = (Reset_Value)&0x3;
  freshnesslength = 64;
  
  freshnessVal[0]=(Trip_Value >> 16)&0xFF;
  freshnessVal[1]=(Trip_Value >> 8)&0xFF;
  freshnessVal[2]=(Trip_Value)&0xFF;
  freshnessVal[3]=(Reset_Value >> 8)&0xFF;
  freshnessVal[4]=(Reset_Value)&0xFF;
  freshnessVal[5]=((RxPDU.msgCnt[index]<<2) >> 16)&0xFF;
  freshnessVal[6]=((RxPDU.msgCnt[index]<<2) >> 8)&0xFF;
  freshnessVal[7]=((RxPDU.msgCnt[index]<<2)|resetflag )&0xFF;
  MAC_in[p++] = freshnessID[0];
  MAC_in[p++] = freshnessID[1];
  for(i=0;i<aPayloadLength-4;i++)
  {
    MAC_in[p++] = data[i];
  }
  for(i=0;i<freshnesslength/8;i++)
  {
    MAC_in[p++] = freshnessVal[i];
  }
  MAC_in_length = p;

  cmac_sm4(keytest,MAC_in,MAC_in_length,MAC_out);
  data[aPayloadLength-4]=freshnessVal[7];
  data[aPayloadLength-3]=MAC_out[0];
  data[aPayloadLength-2]=MAC_out[1];
  data[aPayloadLength-1]=MAC_out[2];
}


void PreProcess_PDU(dword pduID, dword aPayloadLength, byte data[], byte deltacounter, byte CRCerror, byte SecOCerror)
{
  int index;
  index = FindIndex(pduID);
  if(RxPDU.E2Econfigured[index]==1)
  {
    PreProcess_calculateCount(deltacounter,index);
    PreProcess_CRC_Offset(data, aPayloadLength, DataID, RxPDU.E2E_Counter[index], 0); 
    if(CRCerror){data[0]=0xFF;}    
  }
  if(RxPDU.SecOCconfigured[index]==1)
  {
    Preprocess_SecOC(pduID, index, aPayloadLength, data);
    if(SecOCerror==1)
    {
      data[aPayloadLength-4]=0xFF;
      data[aPayloadLength-3]=0xFF;
      data[aPayloadLength-2]=0xFF;
      data[aPayloadLength-1]=0xFF;     
    }
  }
}
