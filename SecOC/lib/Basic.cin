void Getparameters()
{
 
  EcuPort=13400;
  TesterPort=13400;


//  EcuPhyAddr[0]=0x10;
//  EcuPhyAddr[1]=0x15;
////   EcuPhyAddr[0]=0x13;
////  EcuPhyAddr[1]=0x01;
//  TestLogicAddr[0]=0x0E;
//  TestLogicAddr[1]=0x80;
//  EcuFunctionAddr[0]=0x00;
//  EcuFunctionAddr[1]=0x01;

  diagGetTargetQualifier( 0,  EcuIpStr,elCount(EcuIpStr)) < 0 || diagSetTarget(EcuIpStr) ;
  diagGetCommParameter( "DoIP.TESTER_IPAddress", 0, TesterIpStr, elcount( TesterIpStr));
  gTesterLogicAddr = diagGetCommParameter("DoIP.TESTER_LogicalAddress");
  gVehicleLogicAddr = diagGetCommParameter("DoIP.VEHICLE_LogicalAddress");
  gFunctionalLogicAddr = diagGetCommParameter("DoIP.FunctionalAddress");
   EcuIp = IP_Address(198.18.36.96);
//  EcuIp = IP_Address(198.18.36.1);
  TesterIp = IP_Address(198.18.32.1);
  if (EcuIp.PrintAddressToString( EcuIpStr ) == 0);
  if (TesterIp.PrintAddressToString( TesterIpStr ) == 0);
  if (EcuIp.PrintAddressToString( EcuIpStr ) == 0);
  TestLogicAddr[1]=gTesterLogicAddr&0xFF;
  TestLogicAddr[0]=((gTesterLogicAddr& 0xFF00)>>8);
  EcuPhyAddr[1]=gVehicleLogicAddr&0xFF;
  EcuPhyAddr[0]=(gVehicleLogicAddr&0xFF00)>>8;
  EcuFunctionAddr[1]=gFunctionalLogicAddr&0xFF;
  EcuFunctionAddr[0]=(gFunctionalLogicAddr&0xFF00)>>8;
    write("ECUIP %s",EcuIpStr);
    write("TesterIP %s",TesterIpStr);
    write("TestLogicAddr %x  %x",TestLogicAddr[0],TestLogicAddr[1]);
    write("EcuPhyAddr %x  %x",EcuPhyAddr[0],EcuPhyAddr[1]);
    ListenTime=2000;// verify with door
  P2server1=25;
  P2server=25;
  S3server=5000;
  A_DOIP_Announce_Num=0;
  A_DOIP_Announce_Interval=500;
  A_DOIP_Announce_Wait=1000;
}


void ConfigPayload(byte data1[], byte srcaddr[], byte dstaddr[])
{
 
  memcpy_off(data1, 0, srcaddr, 0, 2);
  memcpy_off(data1, 2, dstaddr, 0, 2);
}

void ConfigPayload10session(byte data1[], byte srcaddr[], byte dstaddr[])
{
  memcpy_off(data1, 0, srcaddr, 0, 2);
  memcpy_off(data1, 2, dstaddr, 0, 2);
  data1[4] =0x10;
  data1[5] =0x01;
//  testStep("payload","%x %x %x %x %x %x",data1[0],data1[1],data1[2],data1[3],data1[4],data1[5]);
}

void ByteArray_To_String(byte buffer[], DWORD buffersize, char strPDU[])
{
    
    int i = 0,j = 0;
    int v ,m;
    char vChar,mChar;
    char strKVCTmp[4];
  
    strKVCTmp[2] = ' ';
    strncpy (strPDU,"",elcount(strPDU));
    
    for(i = 0;i < buffersize;i++)
    {
        v = buffer[i]/16;
        m = buffer[i]%16;
     
        if(v>=0&&v<=9)	
        {
            v+=48;
        }	
        else if( v>=97&&v<=122)	
        {
            v=v+87;
        }	
        else 
        {
            v=v+55;
        }	
        vChar = (char)v;
        
        if(m>=0&&m<=9) 
        {
            m+=48;
        }
        else if( m>=97&&m<=122)
        {
            m=m+87;
        }
        else 
        {
            m=m+55;
        }
        mChar = (char)m;
        
        strKVCTmp[0] = vChar;
        strKVCTmp[1] = mChar;
        
        strncat(strPDU, strKVCTmp, gLenPduRaw); 
    }
    str_replace(strPDU, strlen(strPDU)-1, "", 1); 
}