testfunction Send_SecOC_Sync_Msg_J6B(message *SynMessage, dword trip_Cnt, dword reset_Cnt)
{

	SynMessage_global = SynMessage;
	trip_Cnt_global = trip_Cnt;
	reset_Cnt_global = reset_Cnt;
	SynMessage_global_Cnt = 0;
	setTimer(timer50ms, 1);
  testStep("Send_SecOC_Sync_Msg_J6B", "Send Syn message with tripcnt= 0x%x, resetcnt= 0x%x", trip_Cnt,reset_Cnt);
}
testfunction ComKey_EnableReq(byte arg)
{
  byte value;

  if (arg == 1)
  {
    value = 1;
  }
  else
  {
    value = 0;
  }

  ICBVC_SecOCComKeyReq_PDU01_pdu.IComKeyEnbReq = value;

  timer10ms_cnt = 0;
  triggerPDU(ICBVC_SecOCComKeyReq_PDU01_pdu);
  setTimer(timer10ms, 10);

  testStep("ComKey_EnableReq", "ICBVC_SecOCComKeyReq_PDU01_pdu.IComKeyEnbReq= 0x%x", arg);
}

testfunction Verify_ComKey_EnableResp(byte arg)
{
  long result;
  byte actual;

  testStep("Verify_ComKey_EnableResp", "Check IFDRTripCtrRstResp signal equal 0x%x", arg);

  result = testWaitForMessage(IPD_BKPCANFD_Event_FrS35, 1000);

  if (result != 1)
  {
    testStepFail("Verify_ComKey_EnableResp", "Didn't receive any IPD_BKPCANFD_Event_FrS35 message");
  }
  else
  {
    actual = IPD_Sporadic_PDU035_pdu.IIPDComKeyEnbResp;

    if (actual == arg)
    {
      testStepPass("Verify_ComKey_EnableResp", "Received IIPDComKeyEnbResp signal equal 0x%x", arg);
    }
    else
    {
      testStepFail("Verify_ComKey_EnableResp", "Received IIPDComKeyEnbResp signal not equal 0x%x , Actual value = 0x%x", arg,actual );
    }
  }
}

testfunction TripCnt_ResetReq(byte arg)
{
	if (arg == 1)
	{
		ICBVC_SecOCComKeyReq_PDU01_pdu.ITripCntResetReq = 1;
	}
	else
	{
		ICBVC_SecOCComKeyReq_PDU01_pdu.ITripCntResetReq = 0;
	}
	triggerPDU(ICBVC_SecOCComKeyReq_PDU01_pdu);
  testStep("TripCnt_ResetReq", "Send ITripCntResetReq signal equal 0x%x", arg);
}
testfunction Verify_TripCnt_ResetResp(byte arg)
{
	long result;

	testStep("Verify_TripCnt_ResetResp", "Check IIPDTripCntResetResp signal equal 0x%x", arg);
	result = testWaitFormessage(ICBAD_SecOC_ComKeyResp, 1000);
//  Waitfor_Tx_Msg_ID=FDR_SecOC_ComKeyResp_msg.id;
//  result= testWaitForTextEvent(Waitfor_Tx_Msg_event,1000);
	if (result == 1)
	{
		if (ICBAD_SecOCComKeyResp_PDU01_pdu.IIPDTripCntResetResp == arg)
		{
			testStepPass("Verify_TripCnt_ResetResp", "Received IIPDTripCntResetResp signal equal 0x%x", arg);
		}
		else
		{
			testStepFail("Verify_TripCnt_ResetResp", "Received IIPDTripCntResetResp signal not equal 0x%x,actual result 0x%x", arg,ICBAD_SecOCComKeyResp_PDU01_pdu.IIPDTripCntResetResp);
		}
	}
	else
	{
		testStepFail("Verify_TripCnt_ResetResp", "Didn't received any ICBAD_SecOC_ComKeyResp message");
	}
}

testfunction Verify_LogSecOC(dword DataID, dword tripcnt, dword resetcnt, byte ErrorCount)
{
	long result;
  dword val_temp;
	testStep("Verify_LogSecOC", "Check signals equal ");
	result = testWaitFormessage(ICBAD_SecOC_Log, 5000);

	if (result == 1)
	{
    val_temp=$ICBAD_SecOCLog_PDU01::IIPDDataId.raw;
		if (val_temp == DataID)
		{
			testStepPass("IIPDDataId", "signal value equal 0x%x", DataID);
		}
		else
		{
			testStepFail("IIPDDataId", "signal value equal 0x%x,not equal 0x%x", val_temp, DataID);
		}
    val_temp=$ICBAD_SecOCLog_PDU01::IIPDFailedReason.raw;
		if (val_temp == 0x01)
		{
			testStepPass("IIPDFailedReason", "signal value equal 0x%x", 0x01);
		}
		else
		{
			testStepFail("IIPDFailedReason", "signal value equal 0x%x,not equal 0x%x", val_temp, 0x01);
		}
    val_temp=$ICBAD_SecOCLog_PDU01::IIPDTripCnt.raw;
		if (val_temp != tripcnt)
		{
			testStepPass("IIPDTripCnt", "signal value equal 0x%x", tripcnt);
		}
		else
		{
			testStepFail("IIPDTripCnt", "signal value equal 0x%x,not equal 0x%x", val_temp, tripcnt);
		}
    val_temp=$ICBAD_SecOCLog_PDU01::IIPDResetCnt.raw;
		if ( val_temp != resetcnt)
		{
			testStepPass("IIPDResetCnt", "signal value equal 0x%x", resetcnt);
		}
		else
		{
			testStepFail("IIPDResetCnt", "signal value equal 0x%x,not equal 0x%x", val_temp, resetcnt);
		}
    val_temp=$ICBAD_SecOCLog_PDU01::IIPDErrorCount.raw;
		if (val_temp == ErrorCount)
		{
			testStepPass("IIPDErrorCount", "signal value equal 0x%x", ErrorCount);
		}
		else
		{
			testStepFail("IIPDErrorCount", "signal value equal 0x%x,not equal 0x%x", val_temp, ErrorCount);
		}
    val_temp=$ICBAD_SecOCLog_PDU01::IIPDTripNvmTag.raw;
		if (val_temp == 0)
		{
			testStepPass("IIPDTripNvmTag", "signal value equal 0x%x", 0);
		}
		else
		{
			testStepFail("IIPDTripNvmTag", "signal value equal 0x%x,not equal 0x%x", val_temp, 0);
		}
    
        val_temp=$ICBAD_SecOCLog_PDU01::IIPDKeyStatus.raw;
		if (val_temp == 0)
		{
			testStepPass("IIPDKeyStatus", "signal value equal 0x%x", 0);
		}
		else
		{
			testStepFail("IIPDKeyStatus", "signal value equal 0x%x,not equal 0x%x", val_temp, 0);
		}
    
            val_temp=$ICBAD_SecOCLog_PDU01::IIPDAlgFlag.raw;
		if (val_temp == 0)
		{
			testStepPass("IIPDAlgFlag", "signal value equal 0x%x", 0);
		}
		else
		{
			testStepFail("IIPDAlgFlag", "signal value equal 0x%x,not equal 0x%x", val_temp, 0);
		}
     
	}
	else
	{
		testStepFail("Verify_LogSecOC", "Didn't received any ICBAD_SecOC_Log message");
	}
 
}

testcase TC_SecOC_02()
{
	// Requirement: RSY-1317710
	// Purpose:
	// Verify SecOC synchronization mechanism after ECU wakeup:
	// - ECU enters valid operational state
	// - SecOC communication key is enabled
	// - Trip Counter reset routine is executed
	// - Sync message updates TripCnt and ResetCnt correctly
	// - Message Counter resets after synchronization
	// - Secured TX message contains correct freshness and MAC

	long result;

	BeginTest("TC_SecOC_02");

	//--------------------------------------------------
	// Step 1:
	// Reset ECU and wait for normal wakeup
	//--------------------------------------------------
	Reset_P_Switch_ECU();
	testWaitForTimeout(2000);
	setTimer(NMMsg_normal, 10);
	result = testWaitForTextEvent(ECU_Wakeup, 5000);

	if (result == 1)
	{
		testStepPass("Precondition", "ECU wakeup");
	}
	else
	{
		testStepFail("Precondition", "ECU didn't wakeup");
	}

	//--------------------------------------------------
	// Step 2:
	// Enable SecOC and reset Trip Counter
	//--------------------------------------------------
	ComKey_EnableReq(1);
	TripCnt_ResetReq(1);
	testWaitForTimeout(200);

	//--------------------------------------------------
	// Baseline Sync:
	// Use ResetCnt=1 for initialization only
	//--------------------------------------------------
//	Send_SecOC_Sync_Msg_J6B(SecOC_Syn_msg, 1, 1);
//	Waitfor_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 300);
//
//	testStepPass("Baseline Sync",
//	             "Initial synchronization established with TripCnt=1 ResetCnt=1");

	//--------------------------------------------------
	// Sync Verification Loop:
	// ResetCnt = 2 ? 6
	//--------------------------------------------------

  	//---------------- ResetCnt = 1 ----------------
	
	Send_SecOC_Sync_Msg_J6B(SecOC_Syn_msg, 1, 1);
	Waitfor_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 500);
  testWaitForTimeout(50);
	Verify_SecOC_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 1, 1, 1);
  
  
  testWaitForTimeout(500);
	//---------------- ResetCnt = 2 ----------------
	Send_SecOC_Sync_Msg_J6B(SecOC_Syn_msg, 1, 2);
	Waitfor_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 500);
  testWaitForTimeout(50);
	Verify_SecOC_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 1, 2, 1);

//	//---------------- ResetCnt = 3 ----------------
//
   testWaitForTimeout(500);
	Send_SecOC_Sync_Msg_J6B(SecOC_Syn_msg, 1, 3);
	Waitfor_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 500);
  testWaitForTimeout(100);
	Verify_SecOC_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 1, 3, 1);

	//---------------- ResetCnt = 4 ----------------
 testWaitForTimeout(500);
	Send_SecOC_Sync_Msg_J6B(SecOC_Syn_msg, 1, 4);
	Waitfor_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 500);
  	testWaitForTimeout(100);
	Verify_SecOC_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 1, 4, 1);

	//---------------- ResetCnt = 5 ----------------
	testWaitForTimeout(500);
	Send_SecOC_Sync_Msg_J6B(SecOC_Syn_msg, 1, 5);
	Waitfor_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 500);
  	testWaitForTimeout(100);
	Verify_SecOC_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 1, 5, 1);

	//---------------- ResetCnt = 6 ----------------
	testWaitForTimeout(500);
	Send_SecOC_Sync_Msg_J6B(SecOC_Syn_msg, 1, 6);
	Waitfor_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 500);
  	testWaitForTimeout(100);
	Verify_SecOC_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 1, 6, 1);
  
  	//---------------- ResetCnt = 7 ----------------
	testWaitForTimeout(500);
	Send_SecOC_Sync_Msg_J6B(SecOC_Syn_msg, 1, 7);
	Waitfor_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 500);
  	testWaitForTimeout(100);
	Verify_SecOC_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 1, 7, 1);
  
  	//---------------- ResetCnt = 8 ----------------
	testWaitForTimeout(500);
	Send_SecOC_Sync_Msg_J6B(SecOC_Syn_msg, 1, 8);
	Waitfor_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 500);
  	testWaitForTimeout(100);
	Verify_SecOC_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 1, 8, 1);

	//--------------------------------------------------
	// End test
	//--------------------------------------------------
	StopTest();
}

testcase TC_SecOC_03()
{
	// requirements:RSY-1317714
	long result;
	BeginTest("TC_SecOC_03");

	Reset_P_Switch_ECU();

	setTimer(NMMsg_normal, 10);
	result = testWaitForTextEvent(ECU_Wakeup, 5000);
	if (result == 1)
	{
		testStepPass("Precondition", "ECU wakeup");
	}
	else
		testStepFail("Precondition", "ECU didn't wakeup");
	// Bus Off here

	result = testWaitForTextEvent(ECU_Wakeup, 5000);
	if (result == 1)
	{
		testStepPass("Precondition", "ECU wakeup");
	}
	else
		testStepFail("Precondition", "ECU didn't wakeup");

	ComKey_EnableReq(1);
	//  Verify_ComKey_EnableResp(1);
	TripCnt_ResetReq(1);
	//  Verify_TripCnt_ResetResp(1);
  testWaitForTimeout(200);
	Send_SecOC_Sync_Msg_J6B(SecOC_Syn_msg, 1, 1);

	Waitfor_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 50);
	Verify_SecOC_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 1, 1, 1);

	testWaitForTimeout(1000);
	Send_SecOC_Sync_Msg_J6B(SecOC_Syn_msg, 1, 2);

	Waitfor_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 50);
	Verify_SecOC_Tx_Msg(ICBAD_BKPCANFD_100ms_FrP29_Msg_0x395, 1, 2, 1);

	StopTest();
}

