      }
      if((u32_s_PositionB>>15)&0x1){
        u32_s_PositionC = u32_s_PositionC &((u32_s_PositionC16<<15)|0xFF7FFF);
      }else{
        u32_s_PositionC = u32_s_PositionC |((u32_s_PositionC16<<15));
