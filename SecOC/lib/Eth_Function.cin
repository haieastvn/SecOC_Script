/// <DoIPReceive>
//Receive packet test fuction
export testfunction WaitForRoutingActivationResp(long Timeout, byte SrcAddr[], byte DesAddr[], byte CodeNum )
{
  byte reserve[4] = {0x00, 0x00, 0x00, 0x00};
  long rel;
  L4Protocol = kTcp; 
  memcpy_off(expectdata, 0, SrcAddr, 0, 2);
  memcpy_off(expectdata, 2, DesAddr, 0, 2); 
  expectdata[4] = CodeNum;
  expectLen = 5;
  testStep("WaitForDiagnosticNack", "expect receive routing activation response message: source address(0x%x %x), destination address(0x%x %x), response code(0x%x))", SrcAddr[0], SrcAddr[1], DesAddr[0], DesAddr[1], CodeNum);
  rel = testWaitForTextEvent(Routresp, Timeout);
  if(rel == 1)
  {
    testStepPass("WaitForRoutingActivationResp", "Tester receive routing activation response from ECU with code 0x%x", CodeNum);
  }
  else
  {
    testStepFail("WaitForRoutingActivationResp", "ECU not send routing activation response with code 0x%x", CodeNum);
  }
}

/// <DoIPReceive>
//Receive packet test fuction
export testfunction WaitForRoutingActivationNoResp(long Timeout, byte SrcAddr[], byte DesAddr[], byte CodeNum )
{
  byte reserve[4] = {0x00, 0x00, 0x00, 0x00};
  long rel;
  L4Protocol = kTcp; 
  memcpy_off(expectdata, 0, SrcAddr, 0, 2);
  memcpy_off(expectdata, 2, DesAddr, 0, 2); 
  expectdata[4] = CodeNum;
  expectLen = 5;
  testStep("WaitForDiagnosticNack", "expect receive routing activation response message: source address(0x%x %x), destination address(0x%x %x), response code(0x%x))", SrcAddr[0], SrcAddr[1], DesAddr[0], DesAddr[1], CodeNum);
  rel = testWaitForTextEvent(Routresp, Timeout);
  if(rel == 0)
  {
    testStepPass("WaitForRoutingActivationNoResp", "ECU not send routing activation response with code 0x%x", CodeNum);
  }
  else
  {
    testStepFail("WaitForRoutingActivationNoResp", "Tester receive routing activation response from ECU with code 0x%x", CodeNum);
  }
}

/// <DoIPReceive>
export testfunction WaitForDiagnosticMessageResp(long Timeout, byte SrcAddr[], byte DesAddr[], byte UdsData[])
{
  long rel;
  char str[1500]; 
    int i,j,count;
    long rel2=0;
  Result_Resp=0;
  L4Protocol = kTcp; 
  memcpy_off(expectdata, 0, SrcAddr, 0, 2);
  memcpy_off(expectdata, 2, DesAddr, 0, 2); 
  memcpy_off(expectdata, 4, UdsData, 0,  elCount(UdsData)); 
  expectLen = 4 + elCount(UdsData);
  ByteArray_To_String(expectdata, expectLen, str);
  testStep("WaitForDiagnosticMessageResp", "Expect receive diagnostic message: %s", str);
  count=elCount(UdsData);
  rel = testWaitForTextEvent(Diagmsg, Timeout);
  if(rel == 1)
  {
    
	while(datadoip[12]==0x7F && datadoip[14] ==0x78)
	{
		rel=0;
		rel = testWaitForTextEvent(Diagmsg, 5000);
	}

    if(rel == 1)
    {
      for(i=0;i<count;i++)
      {
          if(datadoip[12+i]==UdsData[i])
          {
              rel2=1;
          }
          else
          {
              rel2=0;
              break;
          }
      }
      if(rel2==1)
      {
        testStepPass("WaitForDiagnosticMessageResp", "Tester receive diagnostic message as expected message from ECU ");  
        Result_Resp=1;
      }
      else
      testStepFail("WaitForDiagnosticMessageResp", "Tester receive diagnostic message different expected message from ECU "); 
    }
    else
    {
      testStepFail("WaitForDiagnosticMessageResp", "ECU not send diagnostic message after 7F %x 78",datadoip[13]);
    }
    
  }
  else
  {
    testStepFail("WaitForDiagnosticMessageResp", "ECU not send diagnostic message ");
  }  

}
