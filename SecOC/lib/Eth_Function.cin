    int Result_Resp;
    message 0x501 NM501 = {DLC=8, byte(0)=0x01, byte(1)=0x50,byte(2)=0xFF, byte(3)=0xFF, byte(4)=0xFF, byte(5)=0xFF, byte(6)=0xFF, byte(7)=0xFF };
    msTimer TesterPresent_Timer;
  byte ListenPort=0;
    char IPaddressSTR[1000];
  //////
 ip_Address 198.18.255.255 BroadCastIPAddress;
 ethernetPacket ICMMsg;
  byte LENGTH1=1;
//  byte PAYLOAD1[50]={0xFF,0xFF,0x00,0x31};
//  byte PAYLOAD1[50]={0xFF,0xFF,0x00,0x00};
  byte PAYLOAD1[50]={0x01};
  byte Datatype_Change=0;
  
  enum VerbosityLevel
  {
    kVERBOSE_OFF = 0,
    kVERBOSE_ERROR,
    kVERBOSE_WARNING,
    kVERBOSE_INFO
  };
  
  enum dhcp_address_state
  {
    NOTAVAILABLE,
    NOTALLOCATED,
    TIMEDOUT,
    ALLOCATED
  };
  
  char gAddressStateNames[4][20] = 
  { 
    "NOTAVAILABLE",
    "NOTALLOCATED",
    "TIMEDOUT",
    "ALLOCATED"
  };
  
  //
  // structures
  //
  
  struct dhcp_lease{
    byte  clientMacId[6];                 // mac id of the dhcp client
    dword ipAddr;                         // ip address of the lease given by the dhcp server
    dword mask;                           // mask of the ip address
    dword time;                           // the lease time 
    dword router;                         // the router address
    enum dhcp_address_state addressState; // marking of the current address state
    dword expirationTime;                 // time when the lease expires
  };
  
  //
  // constants
  //
  const int   kLineLength        = 26;              // number of characters per line in the dhcp servers output console 
  const int   kMaxLines          = 20;              // maximum lines to display
  const int   gVerbosity         = kVERBOSE_ERROR;  // the verbosity level
  const dword kBroadcastIpv4Addr = 0xFFFFFFFF;      // broadcast IP address
  
  // 
  // global variables
  //  
  struct  dhcp_lease gLeases[char[]];     // list of all leases
  dword   gSocket;                        // udp socket opened on port 67 to avoid icmp error messages
  msTimer gUpdatePanelTimer;              // cyclic timer called every second to update the dhcp servers output console
  
   // IP Command Protocol Header Format on Application Layer
    enum OPTYPE
  {
    REQUEST = 0x00,
    SETREQUEST_NORETURN,
    SETREQUEST,
    NOTIFICATION_REQUEST,
    RESPONSE,
    NOTIFICATION,
    NOTIFICATION_CYCLIC,
    ACK = 0x70,
    ERROR = 0xE0
  };
  byte ACTION_LM;
  byte PRIO_LM;
  
  dword ServiceID;
  dword OperationID;
  dword Length;
  dword SenderHandleID;
  byte Protocolversion;
  byte  OpType;
  byte DataType;
  byte ProcFlag;
  byte ErrorCode;
  word ErrorInfor;
  //on ethernet

  word length_Packet;
  byte Tcpbuffer[1500];
  byte Udpbuffer[1500];
  word payloadLength;
  // IP protocol
  ip_Address DesIPAddress;
  ip_Address SourceIPAddress;
  dword SourcePort_SYN;
  dword DestinationPort_SYN;
  dword SourcePort_IPLINK;
  dword DestinationPort_IPLINK;
  ip_Address SourceIP_LINK;
  ip_Address DestinationIP_LINK;
  char TCPConnection[50] = "TcpConnection";
  char TCPClose[50] = "CloseTcpConnect";
  char TCPListen[50] = "ListenTcpConnect";
  char TCPanysignal[50] = "TCP message to transmit any command and control signal!";
  char UDPanysignal[50] = "UDP message to transmit any command and control signal!";
  char TCPSYN[50] = "TCPSYN";
  char TCPSYN_ACK[50] = "TCPSYNACK";
  char TCPACK[50] = "TCPACK";
  char TCPRST[50] = "TCPRST";
  char TCPFIN[50] = "TCPFIN";
  char Security2702[50]="2702";
  char Security2706[50]="2706";
  char Security271A[50]="271A";
  char IP_LINK[50] = "IPLINK";

  //Parameter DOIp
  
  //Timer
  msTimer IP_LINK_DVR_Timer;
  msTimer IP_LINK_DMM_Timer;
  msTimer IP_LINK_VGM_Timer;
  msTimer IP_LINK_TCAM_Timer;
  msTimer IP_LINK_DHU_Timer;
  //Parameter IPLINK
  byte ReSourceGroup_DVR;
  byte Priority_DVR;
  byte ReSourceGroup_TCAM;
  byte Priority_TCAM;
  byte ReSourceGroup_DMM;
  byte Priority_DMM;
  byte ReSourceGroup_VGM;
  byte Priority_VGM;
  byte ReSourceGroup_DHU;
  byte Priority_DHU;
  byte sequence_DVR;
  byte sequence_DMM;
  byte sequence_VGM;
  byte sequence_TCAM;
  byte sequence_DHU;
  byte sequence_ECU;
}

on ethernetPacket *
{
  dword ipHeaderLength;
  byte ipProtocol;
    byte addrAddress[4];  
  char str[3000];
  int ret;
  byte datadoip[1600];
  byte i = 0;
  byte seed_buffer[3];
  byte key_buffer[3] = {0x00, 0x00, 0x00};
//
  
  if(this.dir == rx) return;
//  this.GetDestinationIPAddress(DesIPAddress);
//  this.GetSourceIPAddress(SourceIPAddress);
    addrAddress[0]=this.byte(12);
    addrAddress[1]=this.byte(13);
    addrAddress[2]=this.byte(14);
    addrAddress[3]=this.byte(15);
    SourceIPAddress.SetAddressAsArray( addrAddress );
    addrAddress[0]=this.byte(16);
    addrAddress[1]=this.byte(17);
    addrAddress[2]=this.byte(18);
    addrAddress[3]=this.byte(19);
    DesIPAddress.SetAddressAsArray( addrAddress );
  if (EcuIp == SourceIPAddress)
  {
    switch(this.type)
    {
      case 0x0800: // IPv4
        ipHeaderLength = (this.Byte(0) & 0x0F) * 4;
        ipProtocol = this.Byte(9);
        switch(ipProtocol)
        {
          case 17:
          {
            HandleUDP( this, ipHeaderLength+8, swapWord(this.Word(ipHeaderLength)), swapWord(this.Word(ipHeaderLength+2)) );
//            payloadLength = this.GetData("udp", "data", Udpbuffer);
            this.udp.GetData(0, Udpbuffer, this.udp.byteLength);
            length_Packet = this.udp.byteLength;
            ByteArray_To_String(Udpbuffer, length_Packet, str);
           testStep("Callback", "Receive UDP packet with source address %s : %s", EcuIpStr,str);
            break;
          } 
          case 06:
          {
            if(this.doip.IsAvailable())
            {
              HandleDoIP(this);
            }
            else
            {
//              payloadLength = this.GetData("tcp", "data", Tcpbuffer);
              this.tcp.GetData(0, Tcpbuffer, this.tcp.byteLength);
              length_Packet = this.tcp.byteLength;
              if(length_Packet==0)
              {
                if(this.byte(33)==0x10)
                {
                    TestSupplyTextEvent(TCPACK);
                }
                else if(this.byte(33)==0x12)
                {
                  TestSupplyTextEvent(TCPSYN_ACK);
                }
                else if(this.byte(33)==0x02)
                {
                  SourcePort_SYN=(this.ipv4.byte(0)<<8)|this.ipv4.byte(1);
                  DestinationPort_SYN= ((this.ipv4.byte(2)<<8)|this.ipv4.byte(3));
                  TestSupplyTextEvent(TCPSYN);
                }
                else if(this.byte(33)&0x0F==0x03)
                {
                  TestSupplyTextEvent(TCPRST);
                }
                else if((this.byte(33)&0x0F)==0x01)
                {
                  TestSupplyTextEvent(TCPFIN);
                }
              }
              if(length_Packet>0)
              {
                ByteArray_To_String(Tcpbuffer, length_Packet, str);
                testStep("Callback", "Receive TCP packet tcp: %s", str);
                // Parsing the IP Command header
                Parsing_PDUheader_IP_Command(Tcpbuffer);
                // Determine what type of msg base on PDU header of TCP
                Comparameter_Optype(OpType);
                TestSupplyTextEvent(TCPanysignal); 
              }
            }
          }
        }

      break;
    }
  }
//    if(this.IsAvailable("tcp", "data"))
      
  for (i = 0; i < 0xFF; ++i)
  { 
    if(this.byte(i) == 0x02 && this.byte(i+1) == 0xFD && this.byte(i+2) == 0x80 && this.byte(i+3) == 0x01)
    {
      if (this.byte(i+12) == 0x67 && this.byte(i+13) == 0x01)
      {
        seed_buffer[0] = this.byte(i+14);
        seed_buffer[1] = this.byte(i+15);
        seed_buffer[2] = this.byte(i+16);
        write ("%x %x %x", seed_buffer[0], seed_buffer[1], seed_buffer[2]);
        SecurityAccess_Calc_Key_LV1(seed_buffer, 3, key_buffer);
        write ("%x %x %x", key_buffer[0], key_buffer[1], key_buffer[2]);
        
      }
      if (this.byte(i+12) == 0x67 && this.byte(i+13) == 0x05)
      {
        seed_buffer[0] = this.byte(i+14);
        seed_buffer[1] = this.byte(i+15);
        seed_buffer[2] = this.byte(i+16);
        write ("%x %x %x", seed_buffer[0], seed_buffer[1], seed_buffer[2]);
        SecurityAccess_Calc_Key_LV5(seed_buffer, 3, key_buffer);
        write ("%x %x %x", key_buffer[0], key_buffer[1], key_buffer[2]);
        
      }
      if (this.byte(i+12) == 0x67 && this.byte(i+13) == 0x19)
      {
        seed_buffer[0] = this.byte(i+14);
        seed_buffer[1] = this.byte(i+15);
        seed_buffer[2] = this.byte(i+16);
        write ("%x %x %x", seed_buffer[0], seed_buffer[1], seed_buffer[2]);
        SecurityAccess_Calc_Key_LV19(seed_buffer, 3, key_buffer);
        write ("%x %x %x", key_buffer[0], key_buffer[1], key_buffer[2]);
        
      }
      if(this.byte(i+12) == 0x67 && this.byte(i+13) == 0x02)
      {
        testSupplyTextEvent(Security2702);
      }
       if(this.byte(i+12) == 0x67 && this.byte(i+13) == 0x06)
      {
        testSupplyTextEvent(Security2706);
      }
       if(this.byte(i+12) == 0x67 && this.byte(i+13) == 0x1A)
      {
        testSupplyTextEvent(Security271A);
      }
    }
  }  
}

void OnTcpConnect(dword socket, long result)
{ 
  if(result == 0)
  {  
    testSupplyTextEvent(TCPConnection);
  }  
}

void OnTcpClose(dword socket, long result)
{
  if( socket == CloseSocket)
  {   
    testSupplyTextEvent(TCPClose);
  }
  
}

OnTcpListen(dword socket, long result)
{
  if(ListenPort==0)
  {
    TcpSocket[0] = TcpAccept( socket );
    testSupplyTextEvent(TCPListen);
  }
  else{
    tcpAbort(socket);
  }
  
}
