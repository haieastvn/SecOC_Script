      u32_s_PositionC6 = ((u32_s_PositionB>>23)&0x1)^ ((u32_s_PositionB>>5)&0x1);
      u32_s_PositionC4 = ((u32_s_PositionB>>23)&0x1)^ ((u32_s_PositionB>>3)&0x1);
      
      if((u32_s_PositionB>>20)&0x1){
        u32_s_PositionC = u32_s_PositionC &((u32_s_PositionC21<<20)|0xEFFFFF);
        
      }else{
