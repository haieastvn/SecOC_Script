testcase TC_SecOC_08_09_IAM_BKPCANFD_20ms_FrP10()
{
	long result;
	byte Data_Msg[64];
	byte Data_Msg_Len;
	byte i;
	BeginTest("TC_SecOC_08_IAM_BKPCANFD_20ms_FrP10");

	Reset_P_Switch_ECU();

	setTimer(NMMsg_normal, 100);
	result = testWaitForTextEvent(ECU_Wakeup, 5000);
	if (result == 1)
	{
		testStepPass("Precondition", "ECU wakeup");
	}
	else
		testStepFail("Precondition", "ECU didn't wakeup");

	ComKey_EnableReq(1);
	Verify_ComKey_EnableResp(1);
	TripCnt_ResetReq(1);
	Verify_TripCnt_ResetResp(1);
  testWaitForTimeout(200);
	Send_SecOC_Sync_Msg_J6B(SecOC_Syn_msg, 1, 1);

	// 1.Valid Secured PDU
	// Set signal latter
	Data_Msg_Len = IAM_BKPCANFD_20ms_FrP10_msg.Datalength - (MAC_Truncated_bitLen + Fv_truncated_bitLen) / 8;

	for (i = 0; i < Data_Msg_Len; i++)
	{
		Data_Msg[i] = i;
	}
	Send_SecOC_Rx_Msg(IAM_BKPCANFD_20ms_FrP10_msg, Data_Msg, Data_Msg_Len, 1, 1, 1);
	// Check XCP
	// Don't find signals in A2L

	// 2. Secured PDU wrong MAC
	for (i = 0; i < Data_Msg_Len; i++)
	{
		Data_Msg[i] = i + 2;
	}
	Send_SecOC_Rx_Msg_WrongMAC(IAM_BKPCANFD_20ms_FrP10_msg, Data_Msg, Data_Msg_Len, 1, 1, 2);
	// Check XCP
	// Don't find signals in A2L
	StopTest();
}
