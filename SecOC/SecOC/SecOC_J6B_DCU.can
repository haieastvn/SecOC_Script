testcase TC_SecOC_07_IPD_BKPCANFD_50ms_FrP49()
{
  long result;

  BeginTest("TC_SecOC_07_IPD_BKPCANFD_50ms_FrP49");

  Reset_P_Switch_ECU();
  setTimer(NMMsg_normal, 10);

  result = testWaitForTextEvent(ECU_Wakeup, 5000);

  if (result != 1)
  {
    testStepFail("Precondition", "ECU didn't wakeup");
  }
  else
  {
    testStepPass("Precondition", "ECU wakeup");
  }

  ComKey_EnableReq(1);
  // Verify_ComKey_EnableResp(1);

  TripCnt_ResetReq(1);
  // Verify_TripCnt_ResetResp(1);
  testWaitForTimeout(200);
  Send_SecOC_Sync_Msg_J6B(SecOC_Syn_msg, 1, 1);

  Waitfor_Tx_Msg(IPD_BKPCANFD_50ms_FrP49_MsgID_0x2DD, 200);
  Verify_SecOC_Tx_Msg(IPD_BKPCANFD_50ms_FrP49_MsgID_0x2DD, 1, 1, 1);

  Waitfor_Tx_Msg(IPD_BKPCANFD_50ms_FrP49_MsgID_0x2DD, 150);
  Verify_SecOC_Tx_Msg(IPD_BKPCANFD_50ms_FrP49_MsgID_0x2DD, 1, 1, 2);

  StopTest();
}

