void GetMaxTimeParameter(float timeArry[])
{
  int i;
  MaxTime = _max(timeArry[0], timeArry[1]); 
  for(i = 2; i< elCount(timeArry); i++)
  {
    MaxTime = _max(MaxTime, timeArry[i]); 
  }   
}
/// <DoIPSend>
export testfunction Active_TesterPresent(byte status)
{
  if(status==1)
  {
    teststepPass("TesterPresent","Enable Active Tester Present");
    setTimer(TesterPresent_Timer,3000);
  }
  else
  {
    teststepPass("TesterPresent","Disable Active Tester Present");
    cancelTimer(TesterPresent_Timer);
  }
  
}
/// <IP_Command>
export testfunction Send_Ip_Command_TCP(byte OP_TYPE,byte PAYLOAD[],dword LENGTHPAYLOAD)
{
   int i;
  char STR_TEMP[500];
  ByteArray_To_String(PAYLOAD,LENGTHPAYLOAD,STR_TEMP);
  switch(OP_TYPE)
  {
    case 0:
      {
        testStep("Request_type","Payload Str %s",STR_TEMP);
        break;
      }
    case 1:
       testStep("SetRequest_NoReturn","Payload Str %s",STR_TEMP);
       break;
    case 2:
    testStep("SetRequest","Payload Str %s",STR_TEMP);
    break;
    case 3:
    testStep("Notification_Request","Payload Str %s",STR_TEMP);
    break;
    case 4:
    testStep("Response_type","Payload Str %s",STR_TEMP);
    break;
    case 5:
    testStep("Notification","Payload Str %s",STR_TEMP);
    break;
    case 6:
    testStep("Notification_Cycle","Payload Str %s",STR_TEMP);
    break;
    case 0x70:
    testStep("ACK","Payload Str %s",STR_TEMP);
    break;
    case 0xE0:
    testStep("ERROR","Payload Str %s",STR_TEMP);
    break;                                       
  }
  ICMMsg.Clear();
  ICMMsg.source = EthGetMacAddressAsNumber( "02:00:00:00:10:01" );
  
//  ICMMsg.destination = EthGetMacAddressAsNumber( "02:C4:46:18:1E:00" );
  ICMMsg.destination = EthGetMacAddressAsNumber( "02:00:00:00:14:60" );
  ICMMsg.ipv4.init();  

  ICMMsg.ipv4.source.ParseAddress("198.18.32.1");
  
  ICMMsg.ipv4.destination.ParseAddress("198.18.36.96");
//  ICMMsg.ipv4.destination.ParseAddress("192.168.1.2");
  
  ICMMsg.tcp.Init();   
  
  ICMMsg.tcp.source = 50184;
  
  ICMMsg.tcp.destination = 50184;
  
  ICMMsg.SetVlanId(6);
  ICMMsg.SetVlanPriority(7);
  ICMMsg.byte(40) = 0x00;//service id
  ICMMsg.byte(41) = 0x0B;//service id
  
  ICMMsg.byte(42) = 0x00;//operation id
  ICMMsg.byte(43) = 0x01;//operation id

  ICMMsg.byte(44) = (8+LENGTHPAYLOAD)&0xFF000000;;//length
  ICMMsg.byte(45) = (8+LENGTHPAYLOAD)&0xFF0000;;//length
  ICMMsg.byte(46) =(8+LENGTHPAYLOAD)&0xFF00;;//length
  ICMMsg.byte(47) = (8+LENGTHPAYLOAD)&0xFF;//length
  
  ICMMsg.byte(48) = ICMMsg.byte(41);//service id8
  ICMMsg.byte(49) = ICMMsg.byte(43);//operation id8
  ICMMsg.byte(50) = OP_TYPE;//Operation Type
  ICMMsg.byte(51) = 0x00;//SeqNr
  
  ICMMsg.byte(52) = 0x03; //Protocol version 
  ICMMsg.byte(53) = ICMMsg.byte(50); //Operation Type
  ICMMsg.byte(54) = 0x00; //Data type
  ICMMsg.byte(55) = 0x00; //proc
  
  for(i=0;i <LENGTHPAYLOAD;i++)
  {
    ICMMsg.byte(56+i)=PAYLOAD[i];
  }

  
  ICMMsg.Length = 51+LENGTHPAYLOAD;
  ICMMsg.CompletePacket();
  
  output(ICMMsg);
  
}
/// <IP_Command>
export testfunction Send_Ip_Command_UDP(byte OP_TYPE,byte PAYLOAD[],dword LENGTHPAYLOAD)
{
  int i;
  char STR_TEMP[500];
  ByteArray_To_String(PAYLOAD,LENGTHPAYLOAD,STR_TEMP);
  switch(OP_TYPE)
  {
    case 0:
      {
        testStep("Request_type","Payload Str %s",STR_TEMP);
        break;
      }
    case 1:
       testStep("SetRequest_NoReturn","Payload Str %s",STR_TEMP);
       break;
    case 2:
    testStep("SetRequest","Payload Str %s",STR_TEMP);
    break;
    case 3:
    testStep("Notification_Request","Payload Str %s",STR_TEMP);
    break;
    case 4:
    testStep("Response_type","Payload Str %s",STR_TEMP);
    break;
    case 5:
    testStep("Notification","Payload Str %s",STR_TEMP);
    break;
    case 6:
    testStep("Notification_Cycle","Payload Str %s",STR_TEMP);
    break;
    case 0x70:
    testStep("ACK","Payload Str %s",STR_TEMP);
    break;
    case 0xE0:
    testStep("ERROR","Payload Str %s",STR_TEMP);
    break;                                       
  }
  ICMMsg.Clear();
  ICMMsg.source = EthGetMacAddressAsNumber( "02:00:00:00:10:01" );
  
//  ICMMsg.destination = EthGetMacAddressAsNumber( "02:C4:46:18:1E:00" );
  ICMMsg.destination = EthGetMacAddressAsNumber( "02:00:00:00:14:01" );
  ICMMsg.ipv4.init();  

  ICMMsg.ipv4.source.ParseAddress("198.18.32.1");
  
  ICMMsg.ipv4.destination.ParseAddress("198.18.36.1");
//  ICMMsg.ipv4.destination.ParseAddress("192.168.1.2");
  
  ICMMsg.udp.Init();   
  
//  ICMMsg.udp.source = 50184;
  
//  ICMMsg.udp.destination = 50184;
    ICMMsg.udp.source = 66666;
  
  ICMMsg.udp.destination = 66666;
  
  ICMMsg.SetVlanId(6);
  ICMMsg.SetVlanPriority(7);
  ICMMsg.byte(28) = 0x00;//service id
  ICMMsg.byte(29) = 0x0B;//service id
  
  ICMMsg.byte(30) = 0x00;//operation id
  ICMMsg.byte(31) = 0x01;//operation id
  
  ICMMsg.byte(32) = (8+LENGTHPAYLOAD)&0xFF000000;;//length
  ICMMsg.byte(33) = (8+LENGTHPAYLOAD)&0xFF0000;;//length
  ICMMsg.byte(34) =(8+LENGTHPAYLOAD)&0xFF00;;//length
  ICMMsg.byte(35) = (8+LENGTHPAYLOAD)&0xFF;//length
  
  ICMMsg.byte(36) = ICMMsg.byte(29);//service id8
  ICMMsg.byte(37) = ICMMsg.byte(31);//operation id8
  ICMMsg.byte(38) = OP_TYPE;//Operation Type
  ICMMsg.byte(39) = 0x00;//SeqNr
  
  ICMMsg.byte(40) = 0x03; //Protocol version 
  ICMMsg.byte(41) = ICMMsg.byte(38); //Operation Type
  ICMMsg.byte(42) = 0x01; //Data type
  ICMMsg.byte(43) = 0x00; //process
    //payload
  ICMMsg.byte(44) = 0x00; 
  ICMMsg.byte(45) = 0x00; 
  ICMMsg.byte(46) = 0x00; 
  ICMMsg.byte(47) = 0x00; 
  
  for(i=0;i <LENGTHPAYLOAD;i++)
  {
    ICMMsg.byte(44+i)=PAYLOAD[i];
  }
  ICMMsg.Length =44+LENGTHPAYLOAD ;
  ICMMsg.CompletePacket();
  output(ICMMsg);
  
  testStepPass("","Send Success!");

}
