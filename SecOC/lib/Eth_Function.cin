/// <DoIPSend>
export testfunction  SendVehicleIdentifcationRequestMessage(char SrcIp[], dword SrcPort, char DesIp[], dword DesPort, byte data[])
{
  long rel;
 
  char err_String[100], str[1500];
  TxPktData[0] = 0x02;
  TxPktData[1] = 0xFD;
  TxPktData[2] = 0x00;
  if(elCount(data)<10)
  {
     TxPktData[3] = 0x02;
  }
  else
  {
    TxPktData[3] = 0x03;
  }
  write("elCount(data) = %d", elCount(data));
 
  TxPktData[4] = 0x00;
  TxPktData[5] = 0x00;
  TxPktData[6] = 0x00;
  if(elCount(data)<10)
  {
     TxPktData[7] = 0x06;
  }
  else
  {
    TxPktData[7] = 0x11;
  }
  
  memcpy_off(TxPktData, 8, data, 0, elCount(data));
  socket=udpOpen(ipGetAddressAsNumber(SrcIp), SrcPort);
  rel = udpSendTo(socket, ipGetAddressAsNumber(DesIp), DesPort, TxPktData, 8+elCount(data) );
  if (rel == 0)
  { 
    ByteArray_To_String(TxPktData, 8 +elCount(data), str);
    TestSteppass ("VehicleIdentifcationRequestMessage"," DUT  send vehicle identifcation request: %s", str);
  }
 else if ((rel == -1) && (IpGetLastSocketError(socket)== 997))
  {
    ByteArray_To_String(TxPktData, 8 +elCount(data), str);
    TestSteppass ("VehicleIdentifcationRequestMessage"," DUT send vehicle identifcation request:%s", str); 
  }
  else
  {
    IpGetLastSocketErrorAsString( socket, err_String, elcount(err_String));
    TestStepFail("VehicleIdentifcationRequestMessage", " Tester sended vehicle identifcation request failed with result %d (%s)", IpGetLastSocketError(socket), err_String ); 
  } 
}

