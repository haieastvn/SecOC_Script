  byte Temp[7]={0x2F,01,00,03,00,00,01};
  byte DiagMsgNormalModeReq_1[8]={0x23,0x24,0xAF,0x00,0x00,0x00,0xFF,0xF0};
  byte DiagMsgNormalModeReq_2[2]={0x3E,0x80};
  byte DiagMsgNormalModeReq_3[2]={0x10,0x82};
  msTimer tmr;
//  dword gDoIPIntSocket;
  byte DiagMsgSecLv1_2[5]={0x27,0x02, 0x00, 0x00, 0x00};
  byte DiagMsgSecLv5_6[5]={0x27,0x06, 0x00, 0x00, 0x00};
  byte DiagMsgSecLv19_1A[5]={0x27,0x1A, 0x00, 0x00, 0x00};
  msTimer tmr_01_02;
  msTimer tmr_05_06;
  msTimer tmr_19_1A;
  byte  i = 0;
	byte  j = 0;
  byte u8_s_ChangeBitList_FixByte_Seed_01_02[8] = { 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00, 0x00, 0x00 };
  byte u8_s_ChangeBitList_FixByte_Seed_05_06[8] = { 0x35, 0xC5, 0x2E, 0xDB, 0x4A, 0x00, 0x00, 0x00 };
  byte u8_s_ChangeBitList_FixByte_Seed_19_1A[8] = { 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00, 0x00, 0x00 };
  dword u32_s_PositionA = 0xC541A9;
  dword u32_s_PositionB = 0x0;
  dword u32_s_PositionC = 0x0;
  dword u32_s_PositionC21 = 0x0;
  dword u32_s_PositionC16 = 0x0;
  dword u32_s_PositionC13 = 0x0;
  dword u32_s_PositionC6 = 0x0;
