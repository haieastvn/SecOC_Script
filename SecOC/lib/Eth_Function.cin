/// <DoIPSend>
export testfunction  SendTcpDoIPMessae(byte ProVer, byte InverseVer, word msgtype, dword Len, byte payloaddata[], dword SocketId)
{
  long rel;
  char err_String[100];
  char str[1500];
  TxPktData[0] = ProVer;
  TxPktData[1] = InverseVer;
  TxPktData[2] = (byte)(msgtype>>8);
  TxPktData[3] = (byte)(msgtype);
  TxPktData[4] = (byte)(Len >> 24 );
  TxPktData[5] = (byte)(Len >> 16 );
  TxPktData[6] = (byte)(Len >> 8 );
  TxPktData[7] = (byte)(Len );
  write("%02X, %02X ", TxPktData[2],TxPktData[3]);
  
  memcpy_off(TxPktData, 8, payloaddata, 0, elCount(payloaddata));
 
  rel = tcpSend(SocketId, TxPktData, elCount(payloaddata) +8 );
  if (rel == 0)
  { 
    if(elCount(payloaddata)<100)
    {
      ByteArray_To_String(TxPktData, elCount(payloaddata) +8, str);
    }
    
    TestSteppass ("SendWrongDianosticMessae","Tester send DoIP message by TCP: %s", str);
  }
 else if ((rel == -1) && (IpGetLastSocketError(SocketId)== 997))
  {
    TestSteppass ("SendWrongDianosticMessae","Tester send DoIP message by TCP with 997: %s", str);
  }
  else
  {
    IpGetLastSocketErrorAsString( SocketId, err_String, elcount(err_String));
    TestStepFail("SendWrongDianosticMessae", " Tester send DoIP message by TCP failed with result %d (%s)", IpGetLastSocketError(SocketId), err_String ); 
  }
}

