      u32_s_PositionB = ((u32_s_PositionA &0x01)^ ((u8_s_ChangeBitList_FixByte_Seed_19_1A[j-1]>>i)&0x01));
      u32_s_PositionB = (u32_s_PositionB<<23)&0x800000;
