/// <DoIPReceive>
export testfunction WaitForTcpClose(long timeout,  enum Bool Sw,  dword SocketId)
{
  long rel;
  CloseSocket = SocketId;
  if(Sw == kFalse)
  {
    rel = testWaitForTextEvent(TCPClose, timeout);
    if(rel == 0)
    {
      testStepPass("WaitForTcpClose", "Tcp socket(0x%x) do not closed by ECU ", SocketId);
    }
    else
    {
      testStepFail("WaitForTcpClose", "Tcp socket(0x%x) closed by ECU ", SocketId);
    }
  }
  
  else
  {
    
    rel = testWaitForTextEvent(TCPClose, timeout);
    if(rel == 1)
    {
      testStepPass("WaitForTcpClose", "Tcp socket(0x%x) closed by ECU ", SocketId);
      
    }
    else
    {
      testStepFail("WaitForTcpClose", "Tcp socket(0x%x) do not closed by ECU ", SocketId);
    }  
  }

}


/// <DoIPSend>
export testfunction EstablishTcpConnection(long timeout, char SrcIp[], dword SrcPort, char DesIp[], dword DesPort)
{ 
  long rel;
  char errorString[100]; 
  int i;
  testStep("EstablishTcpConnection","Tester IP (%s), Port(%lu);  ECU IP (%s), Port(%lu)", SrcIp, SrcPort, DesIp, DesPort);  
  ipAddAdapterAddress(1, ipGetAddressAsNumber(SrcIp), ipGetAddressAsNumber("255.255.255.0"));
  for(i = 0; i< max; i++)
  {
    if(TcpSocket[i] == 0)
    {
      break ;
    }
  }

  TcpSocket[i] = TcpOpen(ipGetAddressAsNumber(SrcIp), SrcPort);
  testStep("EstablishTcpConnection","TcpSocket[%d] = 0x%x ", i, TcpSocket[i]);
  if (TcpSocket[i] == ~0)
  {
    TestStepFail("EstablishTcpConnection", "TCP connection established failed");
    return;
  }
  rel = TcpConnect (TcpSocket[i], ipGetAddressAsNumber(DesIp), DesPort);
  if ((rel == -1) && (ipGetLastSocketError(TcpSocket[i]) != 10035) ) 
  {
    IpGetLastSocketErrorAsString(TcpSocket[i], errorString, elcount(errorString) );
    TestStepFail("EstablishTcpConnection", "TCP connection established failed, %s (Result %d)", errorString,IpGetLastSocketError(TcpSocket[i]) );
    return;
  }
  rel = testWaitForTextEvent(TCPConnection, timeout);
  if(rel == 1)
  {
    testStepPass ("EstablishTcpConnection","TCP connection established successfully");
    
  }
  else
  {
    TestStepFail("Establish connection", "TCP connection established failed");
  }
}
/// <DoIPReceive>
export testfunction WaitForInternalNodeRequestMessage(long timeout, char SrcIp[], dword SrcPort, char DesIp[] , dword DesPort)
{
    long rel;
    char addrData[16];
    int i;
     
    ipAddAdapterAddress(1, ipGetAddressAsNumber(SrcIp), ipGetAddressAsNumber("255.255.0.0"));
    for(i = 0; i< max; i++)
    {
      if(TcpSocket[i] == 0)
      {
        break ;
      }
    } 

//    gListenSocket = TcpSocket::Open(0, SrcPort);
    TcpSocket[i] = TcpOpen(ipGetAddressAsNumber(SrcIp), SrcPort);
//    TcpAbort(TcpSocket[i]);
    testStep("EstablishTcpConnection","gListenSocket = 0x%x ", TcpSocket[i]);
    if (TcpListen( TcpSocket[i] ) == 0)
    {
      
        rel = testWaitForTextEvent(TCPListen, timeout);
      testStep("EstablishTcpConnection","Tester IP (%s), Port(%lu);  ECU IP (%s), Port(%lu)", SrcIp, SrcPort, DesIp,  SourcePort_SYN); 
        SourceIPAddress.SetAddressAsArray( addrData );
        if((rel == 1))
        {
            testStepPass("WaitForInternalNodeRequestMessage", "Internal node requests to establish TCP_DATA socket with same IP and Port Number"); 
        }
        else
        {
            testStepFail("WaitForInternalNodeRequestMessage", "Internal node not requests to establish TCP_DATA socket with same IP and Port Number"); 
        }
    }
    else
    {
        testStepFail("WaitForInternalNodeRequestMessage", "Internal node not requests to establish TCP_DATA socket"); 
    }
}

/// <DoIPReceive>
export testfunction WaitForVehicleIdentifcationRespMessage(long Timeout)
{
  long rel;
  char str[1500];
  L4Protocol = kUdp; 
  memcpy_off(expectdata, 0, VIN, 0, 17);
  memcpy_off(expectdata, 17, EcuPhyAddr, 0, 2);
  memcpy_off(expectdata, 19, EID, 0, 6);
  memcpy_off(expectdata, 25, GID, 0, 6);
  expectLen = 31;
  ByteArray_To_String(VIN, 17, str);
  testStepPass("WaitForVehicleIdentifcationRespMessage", "Expect VIN: %s", str);
  testStepPass("WaitForVehicleIdentifcationRespMessage", "Expect logic address: 0x%x %x", EcuPhyAddr[0], EcuPhyAddr[1]);
  ByteArray_To_String(EID, 6, str);
  testStepPass("WaitForVehicleIdentifcationRespMessage", "Expect EID: %s", str);
  ByteArray_To_String(GID, 6, str);
  testStepPass("WaitForVehicleIdentifcationRespMessage", "Expect GID: %s", str);
  rel = testWaitForTextEvent(vehicileId, Timeout);
  if(rel == 1)
  {
      testStepPass("WaitForVehicleIdentifcationRequestMessage", "ECU send vehicle identifcation response message"); 
  }
  else
  {
      testStepFail("WaitForVehicleIdentifcationRequestMessage", "ECU not send vehicle identifcation response message"); 
  } 
}

