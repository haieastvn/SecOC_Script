/// <IP_LINK>
void Send_IPLINK(char Source_Mac_Address[],char Destiantion_Mac_Address[],char Source_IPv4[], char Destination_IPV4[],int k )
{
  ethernetPacket IPLMMsg;
  
  IPLMMsg.Clear();
  IPLMMsg.source = EthGetMacAddressAsNumber( Source_Mac_Address );
  
  IPLMMsg.destination = EthGetMacAddressAsNumber( Destiantion_Mac_Address );

  IPLMMsg.ipv4.init();  

  IPLMMsg.ipv4.source.ParseAddress(Source_IPv4);
  
  IPLMMsg.ipv4.destination.ParseAddress(Destination_IPV4);

  
  IPLMMsg.udp.Init();   
  
  IPLMMsg.udp.source = 50001;
  
  IPLMMsg.udp.destination = 50001;
  
  IPLMMsg.SetVlanId(6);
  IPLMMsg.SetVlanPriority(7);
  
  IPLMMsg.byte(28) = 0xFF;//service id
  IPLMMsg.byte(29) = 0xFF;//service id
  
  IPLMMsg.byte(30) = 0xFF;//operation id
  IPLMMsg.byte(31) = 0x01;//operation id
  
  IPLMMsg.byte(32) = 0x00;//length
  IPLMMsg.byte(33) = 0x00;//length
  IPLMMsg.byte(34) = 0x00;//length
  IPLMMsg.byte(35) = 0x0C;//length byte of payload
  
  //SenderHandleID
  IPLMMsg.byte(36) = 0xFF;//service id
  IPLMMsg.byte(37) = 0x01;//operation id
  IPLMMsg.byte(38) = 0x06;//Operation Type
  IPLMMsg.byte(39) = 0x01;//SeqNr
//  IPLMMsg.byte(39)=ser;
//  if(ser>255)
//    ser=0;
//  else ser++;
  
  IPLMMsg.byte(40) = 0x03; //Protocol version 
  
  IPLMMsg.byte(41) = 0x06; //Operation Type
  
  IPLMMsg.byte(42) = 0x01; //Data type
  
  IPLMMsg.byte(43) = 0x00; //proc

  //Payload
//  IPLMMsg.byte(44) = ReSourceGroup; 
//  IPLMMsg.byte(45) = Priority_IPLINK;
  IPLMMsg.byte(46) = 0x00;  
  IPLMMsg.byte(47) = 0x00; 
  
  if( k==0)
  {
    IPLMMsg.byte(39)= sequence_DVR;
    if(sequence_DVR>255) sequence_DVR=0;
    else sequence_DVR++;
    IPLMMsg.byte(44) = ReSourceGroup_DVR; 
    IPLMMsg.byte(45) = Priority_DVR;
  }
    if( k==1)
  {
    IPLMMsg.byte(39)= sequence_DMM;
    if(sequence_DMM>255) sequence_DMM=0;
    else sequence_DMM++;
    IPLMMsg.byte(44) = ReSourceGroup_DMM; 
    IPLMMsg.byte(45) = Priority_DMM;
  }
    if( k==2)
  {
    IPLMMsg.byte(39)= sequence_VGM;
    if(sequence_VGM>255) sequence_VGM=0;
    else sequence_VGM++;
    IPLMMsg.byte(44) = ReSourceGroup_VGM; 
    IPLMMsg.byte(45) = Priority_VGM;
  }
    if( k==3)
  {
    IPLMMsg.byte(39)= sequence_TCAM;
    if(sequence_TCAM>255) sequence_TCAM=0;
    else sequence_TCAM++;
    IPLMMsg.byte(44) = ReSourceGroup_TCAM; 
    IPLMMsg.byte(45) = Priority_TCAM;
  }
    if( k==4)
  {
    IPLMMsg.byte(39)= sequence_DHU;
    if(sequence_DHU>255) sequence_DHU=0;
    else sequence_DHU++;
    IPLMMsg.byte(44) = ReSourceGroup_DHU; 
    IPLMMsg.byte(45) = Priority_DHU;
  }
  IPLMMsg.Length = 48;
  IPLMMsg.CompletePacket();
  
  output(IPLMMsg);
}

/// <NetWork Manager>
export testfunction StartNetworkManager(int time)
{
  setTimer(Send_501,time);
  TestStepPass ("StartNetworkManager","Send 0x501 01 50 FF FF FF FF FF FF with cycle %d", time);
}

/// <NetWork Manager>
export testfunction StopNetworkManager()
{
  cancelTimer(Send_501);
  TestStepPass ("StopNetworkManager","Stop Sending 0x501 01 50 FF FF FF FF FF FF");
}
/// <IPLINK>
export testfunction Start_IP_LINK(int RG,int prio,char Node[])
{
    if (Node[0]=='D' && Node[1]=='V' && Node[2]=='R')
    {
      sequence_DVR=0;
      ReSourceGroup_DVR=RG;
      Priority_DVR=prio;
      Send_IPLINK("02:00:00:00:15:14","FF:FF:FF:FF:FF:FF","198.18.37.20","198.18.255.255",0);
      setTimer(IP_LINK_DVR_Timer,1000);
      TestStep("Start_IP_LINK_DVR","Continuously broadcast the signal (0) with a frequency of 1 per second RG=%x ; Prio= %d ; Node: DVR",ReSourceGroup_DVR,Priority_DVR);
    }
   else if (Node[0]=='D' && Node[1]=='M' && Node[2]=='M')
     {
      sequence_DMM=0;
      ReSourceGroup_DMM=RG;
      Priority_DMM=prio;
      Send_IPLINK("02:00:00:00:10:12","FF:FF:FF:FF:FF:FF","198.18.32.18","198.18.255.255",1);
      setTimer(IP_LINK_DMM_Timer,1000);
      TestStep("Start_IP_LINK_DMM","Continuously broadcast the signal (0) with a frequency of 1 per second RG=%x ; Prio= %d ; Node: DMM",ReSourceGroup_DMM,Priority_DMM);
    }
    else if (Node[0]=='V' && Node[1]=='G' && Node[2]=='M')
    {
      sequence_VGM=0;
      ReSourceGroup_VGM=RG;
      Priority_VGM=prio;
      Send_IPLINK("02:00:00:00:10:01","FF:FF:FF:FF:FF:FF","198.18.32.1","198.18.255.255",2);
      setTimer(IP_LINK_VGM_Timer,1000);
      TestStep("Start_IP_LINK_VGM","Continuously broadcast the signal (0) with a frequency of 1 per second RG=%x ; Prio= %d ; Node: VGM",ReSourceGroup_VGM,Priority_VGM);
    }
    else if (Node[0]=='T' && Node[1]=='C' && Node[2]=='A')
    {
      sequence_TCAM=0;
      ReSourceGroup_TCAM=RG;
      Priority_TCAM=prio;
      Send_IPLINK("02:00:00:00:10:11","FF:FF:FF:FF:FF:FF","198.18.32.17","198.18.255.255",3);
      setTimer(IP_LINK_TCAM_Timer,1000);
      TestStep("Start_IP_LINK_TCAM","Continuously broadcast the signal (0) with a frequency of 1 per second RG=%x ; Prio= %d ; Node:TCAM",ReSourceGroup_TCAM,Priority_TCAM);
    }
      else if (Node[0]=='D' && Node[1]=='H' && Node[2]=='U')
    {
      sequence_DHU=0;
      ReSourceGroup_DHU=RG;
      Priority_DHU=prio;
      Send_IPLINK("02:00:00:00:10:11","FF:FF:FF:FF:FF:FF","198.18.32.17","198.18.255.255",4);
      setTimer(IP_LINK_TCAM_Timer,1000);
      TestStep("Start_IP_LINK_DHU","Continuously broadcast the signal (0) with a frequency of 1 per second RG=%x ; Prio= %d ; Node:DHU",ReSourceGroup_DHU,Priority_DHU);
    }
    
}
/// <IPLINK>
export testfunction Stop_IP_LINK(char Node[])
{
    if (Node[0]=='D' && Node[1]=='V' && Node[2]=='R')
    {
      cancelTimer(IP_LINK_DVR_Timer);
      TestStep("Stop_IP_LINK_DVR","Stop Continuously broadcast the signal (0) with a frequency of 1 per second Node: DVR");
    }
   else if (Node[0]=='D' && Node[1]=='M' && Node[2]=='M')
     {
      cancelTimer(IP_LINK_DMM_Timer);
      TestStep("Stop_IP_LINK_DMM","Stop Continuously broadcast the signal (0) with a frequency of 1 per second Node: DMM");
    }
    else if (Node[0]=='V' && Node[1]=='G' && Node[2]=='M')
    {
      cancelTimer(IP_LINK_VGM_Timer);
      TestStep("Stop_IP_LINK_VGM","Stop Continuously broadcast the signal (0) with a frequency of 1 per second Node: VGM");
    }
    else if (Node[0]=='T' && Node[1]=='C' && Node[2]=='A')
    {
      cancelTimer(IP_LINK_TCAM_Timer);
      TestStep("Stop_IP_LINK_TCAM","Stop Continuously broadcast the signal (0) with a frequency of 1 per second Node: TCAM");
    }
      else if (Node[0]=='D' && Node[1]=='H' && Node[2]=='U')
    {
      cancelTimer(IP_LINK_DHU_Timer);
      TestStep("Stop_IP_LINK_DHU","Stop Continuously broadcast the signal (0) with a frequency of 1 per second Node: DHU");
    }    
      
      
}

export testfunction Reset_P_Switch_ECU_TCP_SYNC()
{
  // Reset Power
  testStepPass("P_Switch","Turn off -> turn on");
  @KA3005P::P_Switch = 0;
  testWaitForTimeout(1000);
  @KA3005P::P_Switch = 1;
  testWaitForTextEvent(TCPSYN, 10000);
}