void HandleDoIP(ethernetPacket * pkt)
{
  
//  byte datadoip[1500];
//  char str[1500];
  int i;
  lendoip = pkt.doip.byteLength;
  pkt.tcp.GetData(0, datadoip, pkt.doip.byteLength);
  ByteArray_To_String(datadoip, lendoip, str_DOIP_packet);
  testStep("Callback", "Receive DoIP packet %d: %s",lendoip, str_DOIP_packet);
  CompareParameters_DoIP( datadoip, lendoip);
  for(i=12;i<lendoip;i++)
  {
    UDS_Data[i-12]=datadoip[i];
  }
  testSupplyTextEvent(Diagmsg);
}
void CompareParameters_DoIP(byte data[], dword length)
{
  word msgType;
  int rel;
  byte payload[1500];
  msgType = (dword)(data[2]<<8) + (dword)( data[3]);
  
  if(msgType == 0x8001) //Diagnostic message
  {
    memcpy_off(payload, 0, data, 8, length);
    if(memcmp(payload, expectdata, expectLen)==0)
//      testSupplyTextEvent(Diagmsg);
    return;
  }
 
  if(msgType == 0x8002) //Diagnostic message positive acknowledgement
  {
    if(data[12] !=0)
      testStep("CompareParameters", "Diagnost ack message with ack code is 0x%x", data[12]);
    testSupplyTextEvent(Diagackmsg);
    return;
  }
  
  if(msgType== 0x8003) //Diagnostic message negative acknowledgement
  {
    memcpy_off(payload, 0, data, 8, length);
    if(memcmp(payload, expectdata, expectLen)==0)
      testSupplyTextEvent(Diagnackmsg);
    return;
  }
  
  if(msgType == 0x07) //Alive check request
  {
    testSupplyTextEvent(AliveCheck);
    return;
  }
  
  if(msgType == 0x00) //Generic DoIP header negative acknowledge
  {
    memcpy_off(payload, 0, data, 8, length);
    if(memcmp(payload, expectdata, expectLen)==0)
      testSupplyTextEvent(HeaderNack);
    return;
  }
  
  if(msgType == 0xF002) //F0002
  {
      testSupplyTextEvent(PayloadTypeF002);
    return;
  }
  if(msgType == 0xF005) //F0005
  {
      testSupplyTextEvent(PayloadTypeF005);
    return;
  }
  if(msgType == 0xF007) //F0007
  {
      testSupplyTextEvent(PayloadTypeF007);
    return;
  }
   if(msgType == 0x06) //Routing activation response
  {
    memcpy_off(payload, 0, data, 8, length);
    if(memcmp(payload, expectdata, expectLen)==0)
      testSupplyTextEvent(Routresp);
    return;
  }
  
  if(msgType == 0x04)  //Vehicle announcement message
  {
    testSupplyTextEvent(vehicileId1);
    memcpy_off(payload, 0, data, 8, length);
    if(memcmp(payload, expectdata, expectLen)==0)
      testSupplyTextEvent(vehicileId);
    return;
  }
  if(msgType == 0x4002) //DoIP entity status response
  {
    testSupplyTextEvent(vehicileId1);
    memcpy_off(payload, 0, data, 8, length);
    if(memcmp(payload, expectdata, expectLen)==0)
      testSupplyTextEvent(DoIPEntity);
    return;
  }
 
  if(msgType == 0x4004) //Diagnostic power mode information response
  {
    testSupplyTextEvent(PowerMode);
    return;
  }
}
void Comparameter_Optype(byte OperationType)
{
  switch(OperationType)
  {
    case 0x00:
    {
      testSupplyTextEvent("REQUEST");
      break;  
    }
    case 0x01:
    {
      testSupplyTextEvent("SETREQUEST_NORETURN"); 
      break;  
    }
    case 0x02:
    {
      testSupplyTextEvent("SETREQUEST"); 
      break;  
    }    
    case 0x03:
    {
      testSupplyTextEvent("NOTIFICATION_REQUEST");  
      break;  
    }
    case 0x04:
    {
      testSupplyTextEvent("RESPONSE");  
      break;  
    } 
    case 0x05:
    {
      testSupplyTextEvent("NOTIFICATION"); 
      break;  
    } 
    case 0x06:
    {
      testSupplyTextEvent("NOTIFICATION_CYCLIC");  
      break;  
    } 
    case 0x70:
    {
      testSupplyTextEvent("ACK");  
      break;  
    } 
    case 0xE0:
    {
      testSupplyTextEvent("ERROR"); 
      break;  
    } 
    default:
    {
      testSupplyTextEvent("Operation Undefined");
      break;
    }
  }
}
void HandleUDP( ethernetPacket * pkt, word udpDataOffset, word srcPort, word dstPort )
{
  word length;
  int ret;
  byte addrAddress[4];  
   SourcePort_IPLINK=(pkt.ipv4.byte(0)<<8)|pkt.ipv4.byte(1);
   DestinationPort_IPLINK= ((pkt.ipv4.byte(2)<<8)|pkt.ipv4.byte(3));

  if(DestinationPort_IPLINK ==50001)
  {
//    ret = pkt.GetDestinationIPAddress(DestinationIP_LINK);
//    ret = pkt.GetSourceIPAddress(SourceIP_LINK);
        addrAddress[0]=pkt.byte(12);
    addrAddress[1]=pkt.byte(13);
    addrAddress[2]=pkt.byte(14);
    addrAddress[3]=pkt.byte(15);
    SourceIP_LINK.SetAddressAsArray( addrAddress );
    addrAddress[0]=pkt.byte(16);
    addrAddress[1]=pkt.byte(17);
    addrAddress[2]=pkt.byte(18);
    addrAddress[3]=pkt.byte(19);
    DestinationIP_LINK.SetAddressAsArray( addrAddress );
    length = pkt.GetData( udpDataOffset, Udpbuffer, elcount(Udpbuffer)-1 );
    Udpbuffer[length] = 0; // terminating zero for strings
    // Parsing the IP LINK
    Parsing_PDUheader_IP_LINK(Udpbuffer); 

 


  }
  else
  {
    length = pkt.GetData( udpDataOffset, Udpbuffer, elcount(Udpbuffer)-1 );
    Udpbuffer[length] = 0; // terminating zero for strings
    // Parsing the IP Command header
    Parsing_PDUheader_IP_Command(Udpbuffer); 
    // Determine what type of msg base on PDU header of UDP
    Comparameter_Optype(OpType); 
    TestSupplyTextEvent(UDPanysignal);
    
  }

}
void Parsing_PDUheader_IP_LINK(byte buffer[])
{

    ServiceID       = (Udpbuffer[0] << 8) | Udpbuffer[1];  
    OperationID     = (Udpbuffer[2] << 8) | Udpbuffer[3];
    Length          = (Udpbuffer[4] << 24) | (Udpbuffer[5] << 16) | (Udpbuffer[6] << 8) | Udpbuffer[7];
    SenderHandleID  = (Udpbuffer[8] << 24) | (Udpbuffer[9] << 16) | (Udpbuffer[10] << 8) | Udpbuffer[11];
    sequence_ECU=Udpbuffer[11];
    Protocolversion = Udpbuffer[12];
    OpType          = Udpbuffer[13];
    DataType        = Udpbuffer[14];
    ProcFlag        = (Udpbuffer[15] & 0x8) >> 7;
    // Link Manager Message
    ACTION_LM       = Udpbuffer[16];
    PRIO_LM         = Udpbuffer[17];
    TestSupplyTextEvent(IP_LINK);
  
}
void Parsing_PDUheader_IP_Command(byte buffer[])
{
  // Parsing the IP Command header
  ServiceID       = (buffer[0] << 8) | buffer[1];  
  OperationID     = (buffer[2] << 8) | buffer[3];
  Length          = (buffer[4] << 24) | (buffer[5] << 16) | (buffer[6] << 8) | buffer[7];
  SenderHandleID  = (buffer[8] << 24) | (buffer[9] << 16) | (buffer[10] << 8) | buffer[11];
  Protocolversion = buffer[12];
  OpType          = buffer[13];
  DataType        = buffer[14];
  ProcFlag        = (buffer[15] & 0x8) >> 7;
  ErrorCode       = buffer[16];
  ErrorInfor      = (buffer[17] << 8) | buffer[18];
  
}




